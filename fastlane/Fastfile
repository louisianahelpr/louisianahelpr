require "base64"
require "fileutils"
require "json"
require "openssl"
require "securerandom"
require "shellwords"
require "tmpdir"
require "yaml"

# Force UTF-8 regardless of the shell's locale.
#
# `sync_metadata_to_xcode!` reads capacitor.config.ts and the metadata files and
# gsub!s them. Those files contain em-dashes and curly quotes (brand copy), so
# when LANG/LC_ALL are unset — which is normal for non-interactive shells, cron
# and most CI runners — Ruby picks US-ASCII as the external encoding and the
# gsub! dies with "invalid byte sequence in US-ASCII" before anything is built.
#
# Observed 2026-08-13: `bundle exec fastlane ios beta` failed at Fastfile:199 on
# a machine with an empty LANG. Setting the env var at the call site fixes that
# invocation and nothing else, so it is set here instead — every lane, every
# runner, whether or not the caller remembered.
Encoding.default_external = Encoding::UTF_8
Encoding.default_internal = Encoding::UTF_8

# Helpr — iOS App Store automation
# Local: bundle exec fastlane ios beta | release
# CI:    invoked by .github/workflows/deploy.yml

default_platform(:ios)

# Resolve paths from the repo root, not from fastlane/ (Fastlane's default cwd).
REPO_ROOT = File.expand_path("..", __dir__)
WORKSPACE = File.join(REPO_ROOT, "ios/App/App.xcworkspace")
PROJECT   = File.join(REPO_ROOT, "ios/App/App.xcodeproj")
SCHEME    = "App"

# Single source of truth: every Xcode project / Info.plist value that
# the App Store record cares about. See fastlane/ios_app_metadata.yml
# for the full list and inline docs for each field.
IOS_METADATA_PATH = File.join(REPO_ROOT, "fastlane/ios_app_metadata.yml")
IOS_METADATA = YAML.safe_load(File.read(IOS_METADATA_PATH), permitted_classes: [], aliases: false)

APP_ID                = IOS_METADATA.fetch("identity").fetch("bundle_id")
APP_TEAM_ID           = IOS_METADATA.fetch("identity").fetch("team_id")
APP_APPLE_ID          = IOS_METADATA.fetch("identity").fetch("apple_id").to_s
APP_SKU               = IOS_METADATA.fetch("identity").fetch("sku").to_s
APP_DISPLAY_NAME      = IOS_METADATA.fetch("display").fetch("name")
APP_PRODUCT_NAME      = IOS_METADATA.fetch("display").fetch("product_name")
APP_CATEGORY_TYPE     = IOS_METADATA.fetch("display").fetch("category_uti")
APP_MARKETING_VERSION = IOS_METADATA.fetch("versioning").fetch("marketing_version").to_s
APP_BUILD_VERSION     = IOS_METADATA.fetch("versioning").fetch("current_project_version").to_s
APP_DEPLOYMENT_TARGET = IOS_METADATA.fetch("build").fetch("ios_deployment_target").to_s
APP_USES_NON_EXEMPT_ENCRYPTION = IOS_METADATA.fetch("build").fetch("uses_non_exempt_encryption")
APP_STORE_METADATA = IOS_METADATA.fetch("app_store")
APP_MARKETING_URL = APP_STORE_METADATA.fetch("marketing_url").to_s
APP_PRIVACY_URL   = APP_STORE_METADATA.fetch("privacy_url").to_s
APP_SUPPORT_URL   = APP_STORE_METADATA.fetch("support_url").to_s
APP_PERMISSION_STRINGS = (IOS_METADATA["permission_strings"] || {}).each_with_object({}) do |(k, v), acc|
  acc[k] = v.to_s.gsub(/\s+/, " ").strip
end

CHANGELOG_PATH = ENV["CHANGELOG_PATH"] || File.join(REPO_ROOT, "fastlane/changelog.txt")

def xcode_build_target
  if File.exist?(WORKSPACE)
    UI.message("Using Xcode workspace: #{WORKSPACE}")
    { workspace: WORKSPACE }
  elsif File.exist?(PROJECT)
    UI.message("Using Xcode project: #{PROJECT} (Swift Package Manager)")
    { project: PROJECT }
  else
    UI.user_error!("Missing #{WORKSPACE} and #{PROJECT}")
  end
end

def changelog_text
  File.exist?(CHANGELOG_PATH) ? File.read(CHANGELOG_PATH) : "Bug fixes and improvements."
end

def assert_ios_identity!
  UI.user_error!("Missing #{PROJECT}") unless File.exist?(PROJECT)
  UI.user_error!("Missing committed Info.plist") unless File.exist?(File.join(REPO_ROOT, "ios/App/App/Info.plist"))

  project_text = File.read(File.join(PROJECT, "project.pbxproj"))
  required_project_values = {
    "PRODUCT_BUNDLE_IDENTIFIER = #{APP_ID};" => "Bundle ID must stay locked to #{APP_ID}",
    "DEVELOPMENT_TEAM = #{APP_TEAM_ID};" => "Apple Developer Team must stay locked to #{APP_TEAM_ID}",
    "INFOPLIST_KEY_CFBundleDisplayName = \"#{APP_DISPLAY_NAME}\";" => "Xcode Display Name must be committed",
    "INFOPLIST_KEY_LSApplicationCategoryType = \"#{APP_CATEGORY_TYPE}\";" => "Xcode App Category must be committed",
    "PRODUCT_NAME = \"#{APP_PRODUCT_NAME}\";" => "Built product name must be #{APP_PRODUCT_NAME}",
    "MARKETING_VERSION = #{APP_MARKETING_VERSION};" => "Marketing version must be #{APP_MARKETING_VERSION}",
    "IPHONEOS_DEPLOYMENT_TARGET = #{APP_DEPLOYMENT_TARGET};" => "Deployment target must be #{APP_DEPLOYMENT_TARGET}"
  }

  required_project_values.each do |needle, message|
    UI.user_error!("#{message}. Missing project setting: #{needle}") unless project_text.include?(needle)
  end

  # CURRENT_PROJECT_VERSION is a floor, not an exact match — `set_next_build_number!`
  # bumps it past TestFlight's latest on every archive, and `persist_build_number!`
  # writes the bumped value back into ios_app_metadata.yml. Anything below the floor
  # means a stale project.pbxproj that would get rejected by App Store Connect.
  project_text.scan(/CURRENT_PROJECT_VERSION = (\d+);/).flatten.map(&:to_i).each do |actual|
    next if actual >= APP_BUILD_VERSION.to_i
    UI.user_error!("CURRENT_PROJECT_VERSION #{actual} in project.pbxproj is below the YAML floor #{APP_BUILD_VERSION}. Run `bundle exec fastlane ios sync_xcode_metadata`.")
  end

  info_plist = File.read(File.join(REPO_ROOT, "ios/App/App/Info.plist"))
  UI.user_error!("Info.plist CFBundleDisplayName must be #{APP_DISPLAY_NAME}") unless info_plist.include?("<key>CFBundleDisplayName</key>") && info_plist.include?("<string>#{APP_DISPLAY_NAME}</string>")
  UI.user_error!("Info.plist LSApplicationCategoryType must be #{APP_CATEGORY_TYPE}") unless info_plist.include?("<key>LSApplicationCategoryType</key>") && info_plist.include?("<string>#{APP_CATEGORY_TYPE}</string>")

  capacitor_text = File.read(File.join(REPO_ROOT, "capacitor.config.ts"))
  required_capacitor_values = {
    "appId: '#{APP_ID}'," => "Capacitor appId must match the App Store bundle ID",
    "appName: '#{APP_DISPLAY_NAME}'," => "Capacitor appName must match the Xcode display name",
    "version: '#{APP_MARKETING_VERSION}'," => "Capacitor iOS version must match the marketing version",
    "category: '#{APP_CATEGORY_TYPE}'," => "Capacitor iOS category must match Xcode"
  }
  required_capacitor_values.each do |needle, message|
    UI.user_error!("#{message}. Missing Capacitor setting: #{needle}") unless capacitor_text.include?(needle)
  end

  UI.success("iOS identity is committed — #{APP_DISPLAY_NAME} / #{APP_ID} / #{APP_CATEGORY_TYPE}")
end

def sync_metadata_to_xcode!
  UI.user_error!("Missing #{IOS_METADATA_PATH}") unless File.exist?(IOS_METADATA_PATH)

  plist_path   = File.join(REPO_ROOT, "ios/App/App/Info.plist")
  project_path = File.join(PROJECT, "project.pbxproj")

  # ── 1. Xcode project (project.pbxproj) ──────────────────────────────
  # Every build setting we manage is rewritten across BOTH Debug and
  # Release configurations so Xcode "General" + Signing tabs stay
  # consistent regardless of which scheme a developer opens locally.
  #
  # CURRENT_PROJECT_VERSION is special: we treat the YAML value as a
  # FLOOR. If a previous `fastlane ios beta` run already bumped the
  # project past it (e.g. project=42, yaml=17), we keep the higher value
  # so Apple never sees a regressed build number.
  project_text = File.read(project_path)
  effective_build_version = [
    APP_BUILD_VERSION.to_i,
    *project_text.scan(/CURRENT_PROJECT_VERSION = (\d+);/).flatten.map(&:to_i)
  ].max.to_s

  pbxproj_replacements = {
    /INFOPLIST_KEY_CFBundleDisplayName = .*?;/      => "INFOPLIST_KEY_CFBundleDisplayName = #{APP_DISPLAY_NAME.inspect};",
    /INFOPLIST_KEY_LSApplicationCategoryType = .*?;/ => "INFOPLIST_KEY_LSApplicationCategoryType = #{APP_CATEGORY_TYPE.inspect};",
    /PRODUCT_NAME = .*?;/                            => "PRODUCT_NAME = #{APP_PRODUCT_NAME.inspect};",
    /PRODUCT_BUNDLE_IDENTIFIER = .*?;/               => "PRODUCT_BUNDLE_IDENTIFIER = #{APP_ID};",
    /DEVELOPMENT_TEAM = .*?;/                        => "DEVELOPMENT_TEAM = #{APP_TEAM_ID};",
    /MARKETING_VERSION = .*?;/                       => "MARKETING_VERSION = #{APP_MARKETING_VERSION};",
    /CURRENT_PROJECT_VERSION = .*?;/                 => "CURRENT_PROJECT_VERSION = #{effective_build_version};",
    /IPHONEOS_DEPLOYMENT_TARGET = .*?;/              => "IPHONEOS_DEPLOYMENT_TARGET = #{APP_DEPLOYMENT_TARGET};"
  }
  pbxproj_replacements.each { |pattern, replacement| project_text.gsub!(pattern, replacement) }
  File.write(project_path, project_text)

  # ── 2. Info.plist ───────────────────────────────────────────────────
  # We can't safely round-trip Info.plist through REXML — Xcode emits a
  # specific DOCTYPE + indentation that REXML mangles, and `plutil` is
  # not available on the Linux runner. A precise line-anchored substitution
  # keeps the file byte-identical except for the values we own.
  plist_text = File.read(plist_path)

  upsert_plist_string = lambda do |key, value|
    pattern = /(<key>#{Regexp.escape(key)}<\/key>\s*\n\s*<string>)[^<]*(<\/string>)/m
    if plist_text =~ pattern
      plist_text.sub!(pattern, "\\1#{value}\\2")
    else
      # Append before closing </dict> if the key isn't there yet.
      insertion = "\t<key>#{key}</key>\n\t<string>#{value}</string>\n"
      plist_text.sub!(/<\/dict>\s*<\/plist>/, "#{insertion}</dict>\n</plist>")
    end
  end

  upsert_plist_bool = lambda do |key, value|
    bool_xml = value ? "<true/>" : "<false/>"
    pattern = /(<key>#{Regexp.escape(key)}<\/key>\s*\n\s*)<(?:true|false)\/>/m
    if plist_text =~ pattern
      plist_text.sub!(pattern, "\\1#{bool_xml}")
    else
      insertion = "\t<key>#{key}</key>\n\t#{bool_xml}\n"
      plist_text.sub!(/<\/dict>\s*<\/plist>/, "#{insertion}</dict>\n</plist>")
    end
  end

  upsert_plist_string.call("CFBundleDisplayName", APP_DISPLAY_NAME)
  upsert_plist_string.call("LSApplicationCategoryType", APP_CATEGORY_TYPE)
  upsert_plist_bool.call("ITSAppUsesNonExemptEncryption", APP_USES_NON_EXEMPT_ENCRYPTION)
  APP_PERMISSION_STRINGS.each { |key, value| upsert_plist_string.call(key, value) }

  File.write(plist_path, plist_text)

  # ── 3. Capacitor config ───────────────────────────────────────────────
  # `npx cap sync ios` reads this file after the Fastlane sync step. Keep it
  # aligned so Capacitor cannot regenerate stale app identifiers, names, or
  # version metadata into the native project.
  capacitor_config_path = File.join(REPO_ROOT, "capacitor.config.ts")
  capacitor_text = File.read(capacitor_config_path)
  capacitor_replacements = {
    /appId: ['"].*?['"],/              => "appId: '#{APP_ID}',",
    /appName: ['"].*?['"],/            => "appName: '#{APP_DISPLAY_NAME}',",
    /appleId: ['"].*?['"],/            => "appleId: '#{APP_APPLE_ID}',",
    /sku: ['"].*?['"],/                => "sku: '#{APP_SKU}',",
    /version: ['"].*?['"],/            => "version: '#{APP_MARKETING_VERSION}',",
    /build: ['"].*?['"],/              => "build: '#{effective_build_version}',",
    /category: ['"].*?['"],/           => "category: '#{APP_CATEGORY_TYPE}',",
    /supportUrl: ['"].*?['"],/         => "supportUrl: '#{APP_SUPPORT_URL}',",
    /privacyPolicyUrl: ['"].*?['"],/   => "privacyPolicyUrl: '#{APP_PRIVACY_URL}',",
    /marketingUrl: ['"].*?['"],/       => "marketingUrl: '#{APP_MARKETING_URL}',"
  }
  capacitor_replacements.each { |pattern, replacement| capacitor_text.gsub!(pattern, replacement) }
  File.write(capacitor_config_path, capacitor_text)

  # ── 4. Mirror the App Store-facing fastlane/metadata files so deliver
  #      and Xcode never disagree on display name / category. ──────────
  FileUtils.mkdir_p(File.join(REPO_ROOT, "fastlane/metadata/en-US"))
  File.write(File.join(REPO_ROOT, "fastlane/metadata/en-US/name.txt"), "#{APP_DISPLAY_NAME}\n")
  File.write(File.join(REPO_ROOT, "fastlane/metadata/en-US/marketing_url.txt"), "#{APP_MARKETING_URL}\n")
  File.write(File.join(REPO_ROOT, "fastlane/metadata/en-US/privacy_url.txt"), "#{APP_PRIVACY_URL}\n")
  File.write(File.join(REPO_ROOT, "fastlane/metadata/en-US/support_url.txt"), "#{APP_SUPPORT_URL}\n")
  category_token = APP_CATEGORY_TYPE.split(".").last.upcase.tr("-", "_")
  category_token = "PHOTO_AND_VIDEO" if category_token == "PHOTOGRAPHY"
  category_token = "HEALTH_AND_FITNESS" if category_token == "HEALTHCARE_FITNESS"
  category_token = "GRAPHICS_AND_DESIGN" if category_token == "GRAPHICS_DESIGN"
  File.write(File.join(REPO_ROOT, "fastlane/metadata/primary_category.txt"), "#{category_token}\n")

  UI.success(
    "Synced fastlane/ios_app_metadata.yml → Xcode\n" \
    "  display name           : #{APP_DISPLAY_NAME}\n" \
    "  product name           : #{APP_PRODUCT_NAME}\n" \
    "  bundle id / team       : #{APP_ID} / #{APP_TEAM_ID}\n" \
    "  marketing / build      : #{APP_MARKETING_VERSION} (#{APP_BUILD_VERSION})\n" \
    "  iOS deployment target  : #{APP_DEPLOYMENT_TARGET}\n" \
    "  category               : #{APP_CATEGORY_TYPE}\n" \
    "  App Store IDs / SKU    : #{APP_APPLE_ID} / #{APP_SKU}\n" \
    "  App Store URLs         : #{APP_MARKETING_URL}, #{APP_PRIVACY_URL}, #{APP_SUPPORT_URL}\n" \
    "  non-exempt encryption  : #{APP_USES_NON_EXEMPT_ENCRYPTION}\n" \
    "  permission strings     : #{APP_PERMISSION_STRINGS.keys.join(', ')}"
  )
end

def ci_fallback_build_number
  run_number = ENV["GITHUB_RUN_NUMBER"].to_s.strip
  run_id = ENV["GITHUB_RUN_ID"].to_s.strip
  base_number = run_number.empty? ? run_id : run_number
  return "" if base_number.empty?

  run_attempt = ENV.fetch("GITHUB_RUN_ATTEMPT", "1").to_s.strip
  "#{base_number}#{run_attempt.rjust(2, "0")}"
end

def ci_environment?
  [ENV["CI"], ENV["GITHUB_ACTIONS"], ENV["GITHUB_RUN_ID"]].any? do |value|
    normalized = value.to_s.strip.downcase
    !normalized.empty? && normalized != "false" && normalized != "0"
  end
end

def distribution_certificate_p12_base64
  ENV["IOS_DISTRIBUTION_CERTIFICATE_P12_BASE64"].to_s.strip
end

def distribution_certificate_password
  ENV["IOS_DISTRIBUTION_CERTIFICATE_PASSWORD"].to_s
end

def import_distribution_certificate_from_p12!(keychain_name:, keychain_password:)
  encoded_p12 = distribution_certificate_p12_base64
  UI.user_error!("IOS_DISTRIBUTION_CERTIFICATE_P12_BASE64 is required in CI. Export your existing Apple Distribution certificate as a .p12, base64 it, and add it as a GitHub secret.") if encoded_p12.empty?

  p12_path = File.join(Dir.tmpdir, "helpr-distribution-certificate.p12")
  File.binwrite(p12_path, Base64.decode64(encoded_p12))

  import_certificate(
    certificate_path: p12_path,
    certificate_password: distribution_certificate_password,
    keychain_name: keychain_name,
    keychain_password: keychain_password
  )

  UI.success("Imported existing Apple Distribution certificate from IOS_DISTRIBUTION_CERTIFICATE_P12_BASE64")

  # Diagnostic: list what xcodebuild / sigh will actually see in the keychain.
  # If sigh later says "Could not find a matching code signing identity",
  # compare the SHA-1 / common name printed here against what's listed on
  # App Store Connect → Certificates. They MUST match exactly. The most
  # common cause is uploading an Apple Development cert (or a revoked /
  # expired Distribution cert) as IOS_DISTRIBUTION_CERTIFICATE_P12_BASE64.
  begin
    keychain_path = File.expand_path("~/Library/Keychains/#{keychain_name}-db")
    keychain_path = File.expand_path("~/Library/Keychains/#{keychain_name}") unless File.exist?(keychain_path)
    UI.message("---- Identities visible to xcodebuild in #{keychain_name} ----")
    sh("security find-identity -v -p codesigning #{keychain_path.shellescape} || true", log: true)
    UI.message("---- Certificate subject / validity ----")
    sh("security find-certificate -a -p #{keychain_path.shellescape} | openssl x509 -noout -subject -issuer -dates -fingerprint -sha1 2>/dev/null || true", log: true)
    UI.message("--------------------------------------------------------------")
  rescue => diag_err
    UI.important("Could not enumerate keychain identities for diagnostics: #{diag_err.message}")
  end
rescue ArgumentError => e
  UI.user_error!("IOS_DISTRIBUTION_CERTIFICATE_P12_BASE64 is not valid base64: #{e.message}")
ensure
  FileUtils.rm_f(p12_path) if defined?(p12_path) && p12_path
end

def remote_latest_build_number_for_version(api_key, version)
  # Latest build number for the SPECIFIC marketing version on TestFlight.
  latest_testflight_build_number(
    api_key: api_key,
    app_identifier: APP_ID,
    version: version,
    initial_build_number: 0
  ).to_i
rescue => e
  UI.important("Could not read latest TestFlight build for version #{version}: #{e.message}")
  nil
end

def remote_latest_build_number_any_version(api_key)
  # Latest build number across ALL versions on App Store Connect (TestFlight + App Store).
  # This is Apple's true "source of truth" — Apple rejects any new build whose
  # number is <= the highest one they've ever seen for this app, regardless of
  # which marketing version it was attached to.
  latest_testflight_build_number(
    api_key: api_key,
    app_identifier: APP_ID,
    initial_build_number: 0
  ).to_i
rescue => e
  UI.important("Could not read latest TestFlight build (any version): #{e.message}")
  nil
end

def next_build_number(api_key)
  version = get_version_number(
    xcodeproj: PROJECT,
    target: SCHEME
  )

  local_candidate = get_build_number(xcodeproj: PROJECT).to_i + 1
  remote_for_version = remote_latest_build_number_for_version(api_key, version)
  remote_any_version = remote_latest_build_number_any_version(api_key)
  # Apple's rule: next build must be strictly greater than the highest build
  # number ever seen across the whole app, not just this marketing version.
  remote_max = [remote_for_version, remote_any_version].compact.max
  remote_candidate = remote_max ? remote_max + 1 : nil
  ci_candidate = ci_environment? ? ci_fallback_build_number.to_i : nil

  # Allow operator to force a specific floor when ASC's API lags behind the
  # actual latest upload (the Iris validator sometimes knows about a build
  # before `latest_testflight_build_number` does). Set BUILD_NUMBER_FLOOR
  # in the workflow env to bump past a "Redundant Binary Upload" error.
  floor_candidate = ENV["BUILD_NUMBER_FLOOR"].to_s.strip
  floor_candidate = floor_candidate.empty? ? nil : floor_candidate.to_i

  if remote_candidate || ci_candidate || floor_candidate
    candidates = [local_candidate, remote_candidate, ci_candidate, floor_candidate].compact
    chosen = candidates.max
    UI.message("Using unique build number #{chosen} for version #{version} (local #{local_candidate}, remote-for-version #{remote_for_version || 'n/a'}, remote-any-version #{remote_any_version || 'n/a'}, ci #{ci_candidate || 'n/a'}, floor #{floor_candidate || 'n/a'})")
    return chosen
  end

  if ci_environment?
    fallback = ci_fallback_build_number
    return fallback.to_i unless fallback.empty?

    return Time.now.utc.strftime("%Y%m%d%H%M%S").to_i
  end

  local_candidate
end

def set_next_build_number!(api_key)
  build_number = next_build_number(api_key)
  increment_build_number(
    build_number: build_number,
    xcodeproj: PROJECT
  )
  persist_build_number!(build_number)
  UI.success("Using build number #{build_number}")
end

# After bumping the build number, write it back into ios_app_metadata.yml so the
# YAML stays the source of truth and `assert_ios_identity!` keeps passing on the
# next run. Idempotent — never writes a value lower than what's already there.
def persist_build_number!(build_number)
  contents = File.read(IOS_METADATA_PATH)
  current_yaml_floor = contents[/current_project_version:\s*"?(\d+)"?/, 1].to_i
  return if build_number.to_i <= current_yaml_floor

  updated = contents.sub(
    /current_project_version:\s*"?\d+"?/,
    %(current_project_version: "#{build_number}")
  )
  File.write(IOS_METADATA_PATH, updated)
  UI.message("Persisted build number #{build_number} into fastlane/ios_app_metadata.yml")
end

def extract_key_payload(raw_value)
  normalized = raw_value.to_s.strip.sub(/\A["']/, "").sub(/["']\z/, "")
  return normalized unless normalized.start_with?("{")

  parsed = JSON.parse(normalized)
  %w[key_content key private_key p8 api_key].each do |field|
    value = parsed[field].to_s.strip
    return value unless value.empty?
  end

  normalized
rescue JSON::ParserError
  normalized
end

def valid_private_key_content?(value)
  return false if value.to_s.empty? || value.include?("\x00")
  # Apple .p8 keys are PKCS#8 ("BEGIN PRIVATE KEY"). Accept EC/RSA variants too
  # in case someone exported in a different PEM wrapper.
  has_pem_header = value =~ /-----BEGIN (EC |RSA |)PRIVATE KEY-----/
  has_pem_footer = value =~ /-----END (EC |RSA |)PRIVATE KEY-----/
  return false unless has_pem_header && has_pem_footer

  OpenSSL::PKey.read(value)
  true
rescue OpenSSL::PKey::PKeyError, ArgumentError
  false
end

def describe_candidate(candidate)
  bytes = candidate.to_s.bytesize
  preview_head = candidate.to_s.byteslice(0, 30).to_s.dup.force_encoding("UTF-8")
  preview_head = preview_head.scrub("?").gsub(/[^\x20-\x7e]/, ".")
  has_begin = candidate.to_s.include?("BEGIN") ? "yes" : "no"
  has_end = candidate.to_s.include?("END") ? "yes" : "no"
  has_dashes = candidate.to_s.include?("-----") ? "yes" : "no"
  "bytes=#{bytes} starts_with=#{preview_head.inspect} BEGIN=#{has_begin} END=#{has_end} dashes=#{has_dashes}"
end

def normalized_asc_key_content
  raw_key_content = extract_key_payload(ENV["ASC_KEY_CONTENT"] || ENV["ASC_KEY"])
  return "" if raw_key_content.empty?

  candidates = []
  candidates << ["raw", raw_key_content]
  candidates << ["unescaped-newlines", raw_key_content.gsub("\\n", "\n")] if raw_key_content.include?("\\n")
  candidates << ["crlf-stripped", raw_key_content.gsub("\r", "")] if raw_key_content.include?("\r")

  # Try base64 decode (strict first, then lenient that tolerates whitespace/newlines).
  compact_base64 = raw_key_content.gsub(/\s+/, "")
  if !compact_base64.empty? && !raw_key_content.include?("BEGIN")
    begin
      candidates << ["base64-strict", Base64.strict_decode64(compact_base64)]
    rescue ArgumentError
      nil
    end
    begin
      candidates << ["base64-lenient", Base64.decode64(compact_base64)]
    rescue ArgumentError
      nil
    end
  end

  diagnostics = []
  candidates.each do |label, candidate|
    str = candidate.to_s.dup.force_encoding("UTF-8")
    str = str.encode("UTF-8", invalid: :replace, undef: :replace, replace: "") unless str.valid_encoding?
    normalized = str.delete_prefix("\uFEFF").strip
    if valid_private_key_content?(normalized)
      UI.message("ASC_KEY_CONTENT decoded successfully via strategy: #{label}")
      return normalized
    end
    diagnostics << "  - #{label}: #{describe_candidate(normalized)}"
  end

  UI.error("ASC_KEY_CONTENT/ASC_KEY could not be parsed. Tried #{candidates.size} strategies:")
  diagnostics.each { |d| UI.error(d) }
  UI.error("Raw secret length: #{ENV['ASC_KEY_CONTENT'].to_s.bytesize} bytes")
  UI.user_error!("ASC_KEY_CONTENT/ASC_KEY is invalid. Provide raw .p8 text, PEM text with escaped newlines, a base64-encoded .p8 content string, or a JSON secret containing one of: key_content, key, private_key, p8, api_key.")
end


def xcodebuild_auth_key_path
  key_path = ENV["ASC_KEY_PATH"].to_s.strip
  return key_path if !key_path.empty? && File.exist?(key_path)

  key_id = ENV["ASC_KEY_ID"].to_s.strip
  UI.user_error!("ASC_KEY_ID is required for xcodebuild authentication") if key_id.empty?
  decoded_key = normalized_asc_key_content
  UI.user_error!("No App Store Connect API key found. Set ASC_KEY_CONTENT (base64 or raw .p8 text) or ASC_KEY_PATH.") if decoded_key.empty?

  # xcodebuild expects the standard Apple filename pattern: AuthKey_<KEY_ID>.p8
  generated_path = File.join(Dir.tmpdir, "AuthKey_#{key_id}.p8")
  File.write(generated_path, decoded_key)
  generated_path
end

def xcode_target_cli_args
  target = xcode_build_target
  if target[:workspace]
    ["-workspace", target[:workspace], "-scheme", SCHEME]
  else
    ["-project", target[:project], "-scheme", SCHEME]
  end
end

def signing_cli_args
  [
    "-allowProvisioningUpdates",
    "-allowProvisioningDeviceRegistration",
    "-authenticationKeyPath", xcodebuild_auth_key_path,
    "-authenticationKeyID", ENV.fetch("ASC_KEY_ID").to_s.strip,
    "-authenticationKeyIssuerID", ENV.fetch("ASC_ISSUER_ID").to_s.strip,
    "DEVELOPMENT_TEAM=#{ENV.fetch("DEVELOPER_TEAM_ID").to_s.strip}"
  ]
end

def shelljoin_args(args)
  args.flatten.compact.map { |value| Shellwords.escape(value.to_s) }.join(" ")
end

def export_options_plist_path
  plist_path = File.join(Dir.tmpdir, "helpr-export-options.plist")
  team_id = ENV.fetch("DEVELOPER_TEAM_ID").to_s.strip
  profile_name = ENV["HELPR_PROFILE_NAME"].to_s.strip
  signing_style = profile_name.empty? ? "automatic" : "manual"

  provisioning_block = ""
  unless profile_name.empty?
    provisioning_block = <<~XML
      <key>provisioningProfiles</key>
      <dict>
        <key>#{APP_ID}</key>
        <string>#{profile_name}</string>
      </dict>
      <key>signingCertificate</key>
      <string>Apple Distribution</string>
    XML
  end

  plist = <<~PLIST
    <?xml version="1.0" encoding="UTF-8"?>
    <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
    <plist version="1.0">
    <dict>
      <key>method</key>
      <string>app-store</string>
      <key>signingStyle</key>
      <string>#{signing_style}</string>
      <key>teamID</key>
      <string>#{team_id}</string>
      <key>stripSwiftSymbols</key>
      <true/>
      <key>uploadSymbols</key>
      <true/>
      #{provisioning_block}
    </dict>
    </plist>
  PLIST
  File.write(plist_path, plist)
  plist_path
end

def build_ipa_with_xcodebuild(output_name: "Helpr.ipa")
  archive_dir = File.join(REPO_ROOT, "build", "archives")
  export_dir = File.join(REPO_ROOT, "build", "export")
  FileUtils.mkdir_p(archive_dir)
  FileUtils.rm_rf(export_dir)
  FileUtils.mkdir_p(export_dir)

  archive_path = File.join(archive_dir, "Helpr.xcarchive")
  FileUtils.rm_rf(archive_path)

  common_args = xcode_target_cli_args + signing_cli_args

  sh("xcodebuild #{shelljoin_args(common_args + ["-resolvePackageDependencies", "-configuration", "Release"])}")

  archive_args = common_args + [
    "-configuration", "Release",
    "-destination", "generic/platform=iOS",
    "-archivePath", archive_path,
    "clean",
    "archive"
  ]
  sh("set -o pipefail && xcodebuild #{shelljoin_args(archive_args)} | xcbeautify --disable-colored-output")

  export_args = [
    "-exportArchive",
    "-archivePath", archive_path,
    "-exportPath", export_dir,
    "-exportOptionsPlist", export_options_plist_path
  ] + signing_cli_args
  sh("set -o pipefail && xcodebuild #{shelljoin_args(export_args)} | xcbeautify --disable-colored-output")

  produced_ipa = Dir[File.join(export_dir, "*.ipa")].first
  UI.user_error!("xcodebuild export did not produce an .ipa in #{export_dir}") unless produced_ipa

  final_ipa_path = File.join(REPO_ROOT, "build", output_name)
  FileUtils.mkdir_p(File.dirname(final_ipa_path))
  FileUtils.cp(produced_ipa, final_ipa_path)
  final_ipa_path
end

def asc_api_key
  # Normalize everything to raw PEM before passing it to fastlane.
  # This avoids fastlane double-decoding malformed/base64-ish input and fixes
  # the "string contains null byte" failure from App Store Connect auth.
  key_content = normalized_asc_key_content

  params = {
    key_id:    ENV["ASC_KEY_ID"],
    issuer_id: ENV["ASC_ISSUER_ID"],
    duration:  1200,
    in_house:  false
  }

  if !key_content.empty?
    params[:key_filepath] = xcodebuild_auth_key_path
  elsif ENV["ASC_KEY_PATH"] && File.exist?(ENV["ASC_KEY_PATH"])
    params[:key_filepath] = ENV["ASC_KEY_PATH"]
  else
    UI.user_error!("No App Store Connect API key found. Set ASC_KEY_CONTENT (raw .p8 or base64) or ASC_KEY_PATH.")
  end

  app_store_connect_api_key(**params)
end

platform :ios do
  before_all do
    # CI runs build/sync in workflow steps. Skip duplicate work there.
    unless ENV["CI"]
      sh("cd .. && npm run build:ios")
      sh("cd .. && npx cap sync ios")
      # `cap sync` copies dist/ wholesale, sourcemaps included — ~20 MB of
      # .js.map that no runtime ever reads (see the script's header comment).
      # Prune them before the archive so they don't ride into the .ipa. CI
      # does the same in its own sync step in .github/workflows/ios-beta.yml.
      sh("cd .. && npm run strip:ios-sourcemaps")
    end
    sync_metadata_to_xcode!
    assert_ios_identity!
  end

  desc "Sync fastlane/ios_app_metadata.yml into the committed Xcode project and Info.plist"
  lane :sync_xcode_metadata do
    sync_metadata_to_xcode!
    assert_ios_identity!
  end

  # Ensure the committed Xcode project uses the Apple Developer Team ID before
  # archiving, so signing succeeds in CI without manual Xcode edits.
  # On CI we use MANUAL signing because automatic signing requires a logged-in
  # Apple ID account in Xcode's Accounts preferences — which a GitHub Actions
  # runner does not have. Instead we use `sigh` (with the App Store Connect API
  # key) to download/create the App Store distribution profile, then point the
  # Xcode project at that profile by UUID. This works headlessly on CI.
  def configure_signing!(api_key)
    team_id = ENV["DEVELOPER_TEAM_ID"]
    UI.user_error!("DEVELOPER_TEAM_ID env var is required for signing") if team_id.nil? || team_id.strip.empty?

    # 0) On CI: create an ephemeral keychain and make it the default. `cert` will
    #    import the distribution certificate into this keychain so xcodebuild
    #    can find the signing identity. Without this, sigh fetches the profile
    #    but the cert lives nowhere xcodebuild can see it, and archive fails.
    if ci_environment?
      keychain_name     = "fastlane_tmp_keychain"
      keychain_password = ENV["MATCH_KEYCHAIN_PASSWORD"].to_s.strip
      keychain_password = SecureRandom.hex(16) if keychain_password.empty?

      create_keychain(
        name:           keychain_name,
        password:       keychain_password,
        default_keychain: true,
        unlock:         true,
        timeout:        3600,
        lock_when_sleeps: false
      )
      ENV["MATCH_KEYCHAIN_NAME"]     = keychain_name
      ENV["MATCH_KEYCHAIN_PASSWORD"] = keychain_password

      # Import an existing Apple Distribution certificate from CI secrets.
      # This avoids Fastlane creating a new certificate and hitting Apple's
      # "maximum number of Distribution certificates" limit.
      import_distribution_certificate_from_p12!(
        keychain_name: keychain_name,
        keychain_password: keychain_password
      )
    end

    # 1) Fetch (or create) the App Store distribution provisioning profile
    #    via the ASC API key. This drops a .mobileprovision into build/profiles
    #    and exports SIGH_* lane context vars we use below.
    # NOTE: Do NOT pass both `adhoc:` and `development:` to sigh — even when
    # both are false, fastlane's option-conflict check raises
    # "You can't enable both :development and :adhoc". Omitting both defaults
    # to an App Store distribution profile, which is what TestFlight needs.
    # Don't pass `force:` AND `readonly:` together — fastlane's option
    # conflict check raises "You can't enable both :force and :readonly"
    # even when one is set to false. We omit both: sigh will reuse an
    # existing App Store profile if one matches the imported cert, or
    # create a new one if needed. This is the documented default behavior.
    sigh(
      api_key:          api_key,
      app_identifier:   APP_ID,
      team_id:          team_id,
      output_path:      File.join(REPO_ROOT, "build", "profiles")
    )

    profile_name = lane_context[SharedValues::SIGH_NAME] ||
                   ENV["sigh_#{APP_ID}_appstore_profile-name"]
    profile_uuid = lane_context[SharedValues::SIGH_UUID] ||
                   ENV["sigh_#{APP_ID}_appstore"]

    UI.user_error!("sigh did not return a profile name/uuid") if profile_name.nil? || profile_uuid.nil?

    # 2) Switch the Xcode project to MANUAL signing pinned to that profile.
    update_code_signing_settings(
      path:                   PROJECT,
      use_automatic_signing:  false,
      team_id:                team_id,
      bundle_identifier:      APP_ID,
      code_sign_identity:     "Apple Distribution",
      profile_name:           profile_name,
      profile_uuid:           profile_uuid,
      targets:                [SCHEME],
      build_configurations:   ["Release"]
    )

    UI.success("Configured manual signing — team=#{team_id} profile=#{profile_name}")
  end

  def signing_xcargs
    team_id = ENV["DEVELOPER_TEAM_ID"].to_s.strip
    key_id = ENV["ASC_KEY_ID"].to_s.strip
    issuer_id = ENV["ASC_ISSUER_ID"].to_s.strip
    auth_key_path = xcodebuild_auth_key_path

    # -allowProvisioningUpdates lets xcodebuild ask App Store Connect to
    # create/download provisioning assets on CI. The authenticationKey flags
    # make that work without a signed-in Xcode account on the runner.
    #
    # IMPORTANT: do NOT pass `-configuration`, `CODE_SIGN_IDENTITY=`, or
    # `CODE_SIGN_STYLE=` in xcargs. Gym auto-detects `CODE_SIGN_IDENTITY=` in
    # xcargs and treats it as `codesigning_identity`, which then makes gym
    # PREPEND its own `-configuration Release` flag to xcargs while xcodebuild
    # already gets `-configuration Release` from the scheme — Xcode 16 rejects
    # the duplicate with "option '-configuration' may only be provided once".
    # The signing identity, style, and team are already set on the Release
    # build configuration by `configure_signing!` via update_code_signing_settings,
    # so we only need to pass the App Store Connect auth flags here.
    %(-allowProvisioningUpdates -allowProvisioningDeviceRegistration -authenticationKeyPath "#{auth_key_path}" -authenticationKeyID #{key_id} -authenticationKeyIssuerID #{issuer_id} DEVELOPMENT_TEAM=#{team_id})
  end

  def export_options_for_signing
    {
      signingStyle: "automatic",
      teamID:       ENV["DEVELOPER_TEAM_ID"].to_s.strip
    }
  end

  # ──────────────────────────────────────────────────────────────────────
  # TestFlight
  # ──────────────────────────────────────────────────────────────────────
  desc "Bump build number, archive, upload to TestFlight"
  lane :beta do
    api_key = asc_api_key

    configure_signing!(api_key)
    ENV["HELPR_PROFILE_NAME"] = lane_context[SharedValues::SIGH_NAME].to_s
    set_next_build_number!(api_key)

    build_ipa_with_xcodebuild(output_name: "Helpr.ipa")

    # Internal testers get the build automatically once processed.
    # We deliberately do NOT pass `groups` or `distribute_external` here:
    # passing those triggers an external-beta-review submission, which Apple
    # rejects with "Another build is in review" while a previous build is
    # still in review on the same train (e.g. 2001 pending → 2002 fails).
    # Run the `beta_external` lane manually once 2001 finishes review if you
    # want to push a build to external testers.
    upload_to_testflight(
      api_key:                           api_key,
      ipa:                               "build/Helpr.ipa",
      skip_waiting_for_build_processing: false,
      changelog:                         changelog_text,
      distribute_external:               false,
      skip_submission:                   true,
      reject_build_waiting_for_review:   false
    )
  end

  # ──────────────────────────────────────────────────────────────────────
  # Metadata-only sync (no build, no submission)
  #
  # Pushes everything under fastlane/metadata/ to App Store Connect:
  #   - App name, subtitle, promotional text, description, keywords
  #   - Marketing / privacy / support URLs
  #   - Categories
  #   - Review information (demo account, notes, contact)
  #   - Screenshots (if present under fastlane/screenshots/)
  #
  # Does NOT build the app, does NOT bump the build number, and does NOT
  # submit anything for App Store review. Safe to run anytime — Apple just
  # updates the "Prepare for Submission" version's listing fields.
  #
  # Run from GitHub Actions → "iOS Metadata Sync (App Store Connect + Xcode)" → "Run workflow",
  # or locally with: bundle exec fastlane ios metadata
  # ──────────────────────────────────────────────────────────────────────
  desc "Upload App Store listing metadata (text, URLs, screenshots) without building or submitting"
  lane :metadata do
    api_key = asc_api_key

    source_metadata_dir = File.join(REPO_ROOT, "fastlane/metadata")
    source_screenshots_dir = File.join(REPO_ROOT, "fastlane/screenshots")
    allowed_metadata_entries = %w[
      en-US
      review_information
      copyright.txt
      primary_category.txt
      primary_first_sub_category.txt
      primary_second_sub_category.txt
      secondary_category.txt
    ]

    Dir.mktmpdir("helpr-deliver-") do |staging_root|
      staged_metadata_dir = File.join(staging_root, "metadata")
      FileUtils.mkdir_p(staged_metadata_dir)

      allowed_metadata_entries.each do |entry|
        source = File.join(source_metadata_dir, entry)
        next unless File.exist?(source)

        FileUtils.cp_r(source, File.join(staged_metadata_dir, entry))
      end

      staged_screenshots_dir = File.join(staging_root, "screenshots")
      screenshots_present = Dir.exist?(source_screenshots_dir) &&
                            !Dir.glob(File.join(source_screenshots_dir, "**/*.{png,jpg,jpeg}")).empty?
      FileUtils.cp_r(source_screenshots_dir, staged_screenshots_dir) if screenshots_present

      UI.message("Uploading staged metadata from #{staged_metadata_dir}")

      upload_args = {
        api_key:                              api_key,
        app_identifier:                       APP_ID,
        skip_binary_upload:                   true,
        submit_for_review:                    false,
        automatic_release:                    false,
        force:                                true,
        precheck_include_in_app_purchases:    false,
        skip_metadata:                        false,
        metadata_path:                        staged_metadata_dir,
        skip_screenshots:                     !screenshots_present,
        ignore_language_directory_validation: true
      }
      upload_args[:screenshots_path] = staged_screenshots_dir if screenshots_present

      upload_to_app_store(**upload_args)
    end

    UI.success("App Store metadata synced from fastlane/metadata/ → App Store Connect")
  end

  # ──────────────────────────────────────────────────────────────────────
  # App Store submission
  # ──────────────────────────────────────────────────────────────────────
  desc "Bump build, archive, upload, and submit for App Store review"
  lane :release do
    api_key = asc_api_key

    configure_signing!(api_key)
    ENV["HELPR_PROFILE_NAME"] = lane_context[SharedValues::SIGH_NAME].to_s
    set_next_build_number!(api_key)

    build_ipa_with_xcodebuild(output_name: "Helpr.ipa")

    # Stage a clean metadata directory containing only App Store-valid entries.
    # The raw fastlane/metadata folder also holds custom_product_pages/ and
    # ppo_tests/ subfolders, which `deliver` rejects as "unsupported language
    # directory names". We copy only the allowed entries into a temp dir.
    source_metadata_dir = File.join(REPO_ROOT, "fastlane/metadata")
    source_screenshots_dir = File.join(REPO_ROOT, "fastlane/screenshots")
    allowed_metadata_entries = %w[
      en-US
      review_information
      copyright.txt
      primary_category.txt
      primary_first_sub_category.txt
      primary_second_sub_category.txt
      secondary_category.txt
    ]

    Dir.mktmpdir("helpr-deliver-release-") do |staging_root|
      staged_metadata_dir = File.join(staging_root, "metadata")
      FileUtils.mkdir_p(staged_metadata_dir)

      allowed_metadata_entries.each do |entry|
        source = File.join(source_metadata_dir, entry)
        next unless File.exist?(source)
        FileUtils.cp_r(source, File.join(staged_metadata_dir, entry))
      end

      screenshots_present = Dir.exist?(source_screenshots_dir) &&
                            !Dir.glob(File.join(source_screenshots_dir, "**/*.{png,jpg,jpeg}")).empty?

      upload_to_app_store(
        api_key:                              api_key,
        ipa:                                  "build/Helpr.ipa",
        app_identifier:                       APP_ID,
        submit_for_review:                    true,
        automatic_release:                    true,
        force:                                true,
        precheck_include_in_app_purchases:    false,
        submission_information: {
          add_id_info_uses_idfa:               false,
          export_compliance_uses_encryption:   false
        },
        release_notes:                        { "en-US" => changelog_text },
        skip_screenshots:                     !screenshots_present,
        screenshots_path:                     source_screenshots_dir,
        skip_metadata:                        false,
        metadata_path:                        staged_metadata_dir,
        ignore_language_directory_validation: true
      )
    end
  end

  # ─────────────────────────────────────────────────────────────────────
  # sync_app_icon — regenerates every iOS AppIcon.appiconset PNG from the
  # single source-of-truth file at public/apple-touch-icon.png (1024×1024).
  #
  # Run locally:  bundle exec fastlane ios sync_app_icon
  # Run in CI:    Actions → "iOS Icon Sync" → Run workflow
  #
  # Requires `magick` (ImageMagick 7) in PATH. macOS runners have it via
  # Homebrew; ubuntu-latest installs it in the workflow.
  # ─────────────────────────────────────────────────────────────────────
  desc "Regenerate iOS AppIcon set from public/apple-touch-icon.png"
  lane :sync_app_icon do
    source = File.join(REPO_ROOT, "public/apple-touch-icon.png")
    UI.user_error!("Missing source icon: #{source}") unless File.exist?(source)

    appiconset = File.join(REPO_ROOT, "ios/App/App/Assets.xcassets/AppIcon.appiconset")
    UI.user_error!("Missing AppIcon.appiconset: #{appiconset}") unless Dir.exist?(appiconset)

    # filename => pixel size. Mirrors Contents.json (iPhone + iPad + marketing).
    targets = {
      "icon-20.png"          => 20,
      "icon-20@2x.png"       => 40,
      "icon-20@2x-ipad.png"  => 40,
      "icon-20@3x.png"       => 60,
      "icon-29.png"          => 29,
      "icon-29@2x.png"       => 58,
      "icon-29@2x-ipad.png"  => 58,
      "icon-29@3x.png"       => 87,
      "icon-40.png"          => 40,
      "icon-40@2x.png"       => 80,
      "icon-40@2x-ipad.png"  => 80,
      "icon-40@3x.png"       => 120,
      "icon-60@2x.png"       => 120,
      "icon-60@3x.png"       => 180,
      "icon-76.png"          => 76,
      "icon-76@2x.png"       => 152,
      "icon-83.5@2x.png"     => 167,
      "icon-1024.png"        => 1024
    }

    magick = `command -v magick`.strip
    convert = `command -v convert`.strip
    bin = !magick.empty? ? "magick" : (!convert.empty? ? "convert" : nil)
    UI.user_error!("ImageMagick not found in PATH (need `magick` or `convert`)") if bin.nil?

    targets.each do |filename, size|
      out = File.join(appiconset, filename)
      # -background white -alpha remove flattens any transparency to white,
      # which matches App Store Connect's requirement that the 1024 marketing
      # icon must have NO alpha channel.
      cmd = "#{bin} #{Shellwords.escape(source)} -resize #{size}x#{size} " \
            "-background white -alpha remove -alpha off " \
            "#{Shellwords.escape(out)}"
      UI.message("→ #{filename} (#{size}×#{size})")
      sh(cmd, log: false)
    end

    UI.success("Regenerated #{targets.size} AppIcon files from public/apple-touch-icon.png")
    UI.message("Commit ios/App/App/Assets.xcassets/AppIcon.appiconset/ then run ios beta to ship.")
  end
end
