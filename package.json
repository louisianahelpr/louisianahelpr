{
  "name": "vite_react_shadcn_ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "migration:new": "node scripts/new-migration.mjs",
    "predev": "rm -rf node_modules/.vite",
    "dev": "vite",
    "build": "vite build && node scripts/build-og-shell.mjs",
    "build:ios": "npm run sync:ios-metadata && VITE_CAPACITOR_BUILD=1 vite build",
    "sync:ios-metadata": "node scripts/sync-ios-metadata.mjs",
    "clear:xcode-cache": "node scripts/clear-xcode-cache.mjs",
    "sync:ios": "npm run clear:xcode-cache && npm run sync:ios-metadata && npx cap sync ios && npm run strip:ios-sourcemaps && npm run sync:ios-metadata && bash scripts/verify-ios-metadata.sh",
    "fix:xcode": "npm run build:ios && npm run sync:ios",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e:happy": "PLAYWRIGHT_WEB_SERVER=1 playwright test --project=happy-path",
    "typecheck": "npm run typecheck:app && npm run typecheck:edge",
    "typecheck:app": "tsc -b --noEmit",
    "typecheck:edge": "node scripts/typecheck-edge.mjs",
    "check:edge": "node scripts/check-edge-syntax.cjs",
    "check:audit-evidence": "node scripts/check-audit-evidence.mjs",
    "db:types": "npx supabase gen types typescript --project-id fncmgoasalhdgfwzhsqa --schema public > src/integrations/supabase/types.ts && echo '\u2713 Regenerated src/integrations/supabase/types.ts (needs SUPABASE_ACCESS_TOKEN env var or supabase login)'",
    "db:diff": "npx supabase db diff --linked --schema public",
    "prepare": "husky || true",
    "check:launch": "HELPR_LAUNCH=1 bash scripts/check-launch-flags.sh",
    "dev:staging": "vite --mode staging",
    "db:staging:link": "npx supabase link --project-ref okpxtpfvwtmbuxugqsws",
    "db:staging:push": "npx supabase db push",
    "deadcode": "knip",
    "deadcode:functions": "node scripts/check-dead-edge-functions.mjs",
    "strip:ios-sourcemaps": "node scripts/strip-ios-sourcemaps.mjs",
    "check:agent-refs": "node scripts/check-agent-refs.mjs",
    "check:claude-md": "node scripts/check-claude-md.mjs",
    "check:surface-owners": "node scripts/check-surface-owners.mjs",
    "check:dead-links": "node scripts/check-dead-links.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix",
    "vercel.json": "node scripts/check-vercel-config.mjs",
    ".claude/**/*.md": "node scripts/check-agent-refs.mjs",
    "CLAUDE.md": [
      "node scripts/check-agent-refs.mjs",
      "node scripts/check-claude-md.mjs"
    ],
    "docs/audit/launch-2026-09/*.md": "node scripts/check-agent-refs.mjs",
    "src/App.tsx": [
      "node scripts/check-surface-owners.mjs",
      "node scripts/check-dead-links.mjs"
    ],
    "src/pages/postjob/EntryChoice.tsx": [
      "node scripts/check-surface-owners.mjs"
    ],
    "src/pages/profile/types.ts": [
      "node scripts/check-surface-owners.mjs"
    ]
  },
