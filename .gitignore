# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Fastlane local-build artifacts (xcarchive, ipa, dSYMs). CI builds via
# GitHub Actions don't produce this directory; only `bundle exec fastlane
# ios beta` locally does, and the output is regenerated every run.
# Also catches `ios/App/build/sim/...` from the iOS Simulator smoke
# harness (scripts/sim-smoke.sh).
build/
ios/App/build/
ios/App/build_sim/

# fastlane's scan/gym JUnit output. Rewritten on every `bundle exec fastlane`
# run, so it shows up as a dirty tree after each local build and gets carried
# into unrelated commits. It is a test REPORT, not source.
fastlane/report.xml
ios/DerivedData/

# Fastlane gem lockfile — `bundle install` regenerates per machine, and
# the workflows in .github/workflows/ run `bundle install` themselves
# rather than relying on a committed lockfile.
Gemfile.lock

# TypeScript incremental build cache
*.tsbuildinfo

# Supabase CLI scratch dir
supabase/.temp/

# Vercel CLI metadata (project + token)
.vercel

# Claude Code agent worktrees / scratch directory at repo root.
# Cowork sessions create these; they're per-machine and shouldn't be tracked.
# The SessionStart hook + shared settings ARE tracked so Claude Code on the
# web can install dependencies at session start.
.claude/*
!.claude/hooks/
!.claude/settings.json
!.claude/commands/
# Project-scoped skills that CLAUDE.md references (see the lh-audit skill
# pointer at the bottom of CLAUDE.md — the skill body has to ship with the
# repo or the pointer is a dead link for CI, other developers, and the
# cloud routines).
!.claude/skills/

# Environment variables (never commit secrets)
.env
# Any local copy of .env — `.env.bak`, `.env.bak.1787028236`, `.env.local.old`.
# The bare `.env` rule above does NOT cover a suffixed sibling, and a backup
# holds the same Supabase keys and MapKit token as the original. One was created
# and left untracked-but-committable during the 2026-08-18 session; it was caught
# by hand, which is not a control.
.env.*
!.env.example
.env.local
.env.*.local
.env.production
.env.development

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Playwright test artifacts
test-results/
playwright-report/

# Playwright-MCP page snapshots and ad-hoc browser screenshots — scratch
# artifacts from local browser-automation runs, never source.
.playwright-mcp/
browse-guest.png

# Chrome-DevTools-MCP audit scratch: screenshots + temp files from the
# interactive audit passes. Regenerated every run, never source.
.audit-shots/
.audit-tmp/

# Edge-function test harness scratch files (see src/test/edge/harness.ts).
# The harness writes a rewritten copy of an edge function here, imports it,
# then deletes it — this catches any left behind by an interrupted run.
src/test/edge/*.gen.ts

# Remember plugin working directory — per-machine session buffer, daily
# notes, and tempfiles (e.g. .remember/tmp/last-ndc.ts). Previously only
# globally-ignored on the maintainer's machine; pinning it here makes the
# ignore portable so a fresh checkout doesn't accidentally track scratch.
.remember/

# Prod-targeted seed scripts that embed the prod project ID and a plaintext
# test-account password. Kept local-only — sibling fixtures like
# scripts/seed-cowork-test-jobs.sql that are safe-for-history stay tracked.
scripts/seed_test_data.sql

# Sim sweep scratch screenshot (audit captures, not source)
sim-sweep.png
.claude-scratch/

# Audit artifacts from background agents — never commit
tmp/audit/
.audit-out/
