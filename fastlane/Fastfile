require "base64"
require "json"
require "openssl"
require "tmpdir"

# Helpr — iOS App Store automation
# Local: bundle exec fastlane ios beta | release
# CI:    invoked by .github/workflows/deploy.yml

default_platform(:ios)

# Resolve paths from the repo root, not from fastlane/ (Fastlane's default cwd).
REPO_ROOT = File.expand_path("..", __dir__)
WORKSPACE = File.join(REPO_ROOT, "ios/App/App.xcworkspace")
PROJECT   = File.join(REPO_ROOT, "ios/App/App.xcodeproj")
SCHEME    = "App"
APP_ID    = "com.Helpr"

CHANGELOG_PATH = ENV["CHANGELOG_PATH"] || File.join(REPO_ROOT, "fastlane/changelog.txt")

def xcode_build_target
  if File.exist?(WORKSPACE)
    UI.message("Using Xcode workspace: #{WORKSPACE}")
    { workspace: WORKSPACE }
  elsif File.exist?(PROJECT)
    UI.message("Using Xcode project: #{PROJECT} (Swift Package Manager)")
    { project: PROJECT }
  else
    UI.user_error!("Missing #{WORKSPACE} and #{PROJECT}")
  end
end

def changelog_text
  File.exist?(CHANGELOG_PATH) ? File.read(CHANGELOG_PATH) : "Bug fixes and improvements."
end

def extract_key_payload(raw_value)
  normalized = raw_value.to_s.strip.sub(/\A["']/, "").sub(/["']\z/, "")
  return normalized unless normalized.start_with?("{")

  parsed = JSON.parse(normalized)
  %w[key_content key private_key p8 api_key].each do |field|
    value = parsed[field].to_s.strip
    return value unless value.empty?
  end

  normalized
rescue JSON::ParserError
  normalized
end

def valid_private_key_content?(value)
  return false if value.to_s.empty? || value.include?("\x00")
  return false unless value.include?("BEGIN PRIVATE KEY") && value.include?("END PRIVATE KEY")

  OpenSSL::PKey.read(value)
  true
rescue OpenSSL::PKey::PKeyError, ArgumentError
  false
end

def normalized_asc_key_content
  raw_key_content = extract_key_payload(ENV["ASC_KEY_CONTENT"] || ENV["ASC_KEY"])
  return "" if raw_key_content.empty?

  candidates = []
  candidates << raw_key_content
  candidates << raw_key_content.gsub("\\n", "\n") if raw_key_content.include?("\\n")

  compact_base64 = raw_key_content.gsub(/\s+/, "")
  if !compact_base64.empty? && !raw_key_content.include?("BEGIN PRIVATE KEY")
    begin
      candidates << Base64.strict_decode64(compact_base64)
    rescue ArgumentError
      nil
    end
  end

  candidates.each do |candidate|
    normalized = candidate.to_s.delete_prefix("\uFEFF").strip
    return normalized if valid_private_key_content?(normalized)
  end

  UI.user_error!("ASC_KEY_CONTENT/ASC_KEY is invalid. Provide raw .p8 text, PEM text with escaped newlines, a base64-encoded .p8 content string, or a JSON secret containing one of: key_content, key, private_key, p8, api_key.")
end

def xcodebuild_auth_key_path
  key_path = ENV["ASC_KEY_PATH"].to_s.strip
  return key_path if !key_path.empty? && File.exist?(key_path)

  key_id = ENV["ASC_KEY_ID"].to_s.strip
  UI.user_error!("ASC_KEY_ID is required for xcodebuild authentication") if key_id.empty?
  decoded_key = normalized_asc_key_content
  UI.user_error!("No App Store Connect API key found. Set ASC_KEY_CONTENT (base64 or raw .p8 text) or ASC_KEY_PATH.") if decoded_key.empty?

  # xcodebuild expects the standard Apple filename pattern: AuthKey_<KEY_ID>.p8
  generated_path = File.join(Dir.tmpdir, "AuthKey_#{key_id}.p8")
  File.write(generated_path, decoded_key)
  generated_path
end

def asc_api_key
  # Normalize everything to raw PEM before passing it to fastlane.
  # This avoids fastlane double-decoding malformed/base64-ish input and fixes
  # the "string contains null byte" failure from App Store Connect auth.
  key_content = normalized_asc_key_content

  params = {
    key_id:    ENV["ASC_KEY_ID"],
    issuer_id: ENV["ASC_ISSUER_ID"],
    duration:  1200,
    in_house:  false
  }

  if !key_content.empty?
    params[:key_filepath] = xcodebuild_auth_key_path
  elsif ENV["ASC_KEY_PATH"] && File.exist?(ENV["ASC_KEY_PATH"])
    params[:key_filepath] = ENV["ASC_KEY_PATH"]
  else
    UI.user_error!("No App Store Connect API key found. Set ASC_KEY_CONTENT (raw .p8 or base64) or ASC_KEY_PATH.")
  end

  app_store_connect_api_key(**params)
end

platform :ios do
  before_all do
    # CI runs build/sync in workflow steps. Skip duplicate work there.
    unless ENV["CI"]
      sh("cd .. && npm run build")
      sh("cd .. && npx cap sync ios")
    end
  end

  # Inject the Apple Developer Team ID into the freshly-generated Xcode
  # project. Capacitor's `cap add ios` scaffolds App.xcodeproj with an empty
  # DEVELOPMENT_TEAM, which causes `xcodebuild archive` to fail with
  # "Signing for App requires a development team". We patch the pbxproj
  # before archiving so signing succeeds in CI without manual Xcode edits.
  def configure_signing!
    team_id = ENV["DEVELOPER_TEAM_ID"]
    UI.user_error!("DEVELOPER_TEAM_ID env var is required for signing") if team_id.nil? || team_id.strip.empty?

    # Apply automatic signing to BOTH Debug and Release so the generated
    # Capacitor project is fully configured on CI.
    update_code_signing_settings(
      path:            PROJECT,
      use_automatic_signing: true,
      team_id:         team_id,
      bundle_identifier: APP_ID,
      targets:         [SCHEME]
    )

    UI.success("Set DEVELOPMENT_TEAM=#{team_id} on target #{SCHEME}")
  end

  def signing_xcargs
    team_id = ENV["DEVELOPER_TEAM_ID"].to_s.strip
    key_id = ENV["ASC_KEY_ID"].to_s.strip
    issuer_id = ENV["ASC_ISSUER_ID"].to_s.strip
    auth_key_path = xcodebuild_auth_key_path

    # -allowProvisioningUpdates lets xcodebuild ask App Store Connect to
    # create/download provisioning assets on CI. The authenticationKey flags
    # make that work without a signed-in Xcode account on the runner.
    #
    # IMPORTANT: do NOT pass `-configuration`, `CODE_SIGN_IDENTITY=`, or
    # `CODE_SIGN_STYLE=` in xcargs. Gym auto-detects `CODE_SIGN_IDENTITY=` in
    # xcargs and treats it as `codesigning_identity`, which then makes gym
    # PREPEND its own `-configuration Release` flag to xcargs while xcodebuild
    # already gets `-configuration Release` from the scheme — Xcode 16 rejects
    # the duplicate with "option '-configuration' may only be provided once".
    # The signing identity, style, and team are already set on the Release
    # build configuration by `configure_signing!` via update_code_signing_settings,
    # so we only need to pass the App Store Connect auth flags here.
    %(-allowProvisioningUpdates -allowProvisioningDeviceRegistration -authenticationKeyPath "#{auth_key_path}" -authenticationKeyID #{key_id} -authenticationKeyIssuerID #{issuer_id} DEVELOPMENT_TEAM=#{team_id})
  end

  def export_options_for_signing
    {
      signingStyle: "automatic",
      teamID:       ENV["DEVELOPER_TEAM_ID"].to_s.strip
    }
  end

  # ──────────────────────────────────────────────────────────────────────
  # TestFlight
  # ──────────────────────────────────────────────────────────────────────
  desc "Bump build number, archive, upload to TestFlight"
  lane :beta do
    api_key = asc_api_key

    configure_signing!
    increment_build_number(xcodeproj: PROJECT)

    # NOTE on `-configuration`: in fastlane 2.233.x + Xcode 16, gym auto-detects
    # `codesigning_identity` from the project's pbxproj (which Capacitor sets to
    # "Apple Distribution"). When gym detects an identity, it PREPENDS
    # `-configuration Release` and `CODE_SIGN_IDENTITY=...` into xcargs while
    # xcodebuild also receives `-configuration` from the scheme/skip_archive
    # path, producing the duplicate that Xcode 16 rejects:
    #   "option '-configuration' may only be provided once"
    #
    # Fix: pass `skip_codesigning: false` and `disable_xcpretty: false` is not
    # enough. The reliable fix is to explicitly set `configuration: "Release"`
    # AND `codesigning_identity: nil` so gym takes the explicit-config code path
    # (single top-level `-configuration` arg, no xcargs prepend).
    build_app(
      **xcode_build_target,
      scheme:                  SCHEME,
      configuration:           "Release",
      codesigning_identity:    nil,
      export_method:           "app-store",
      clean:                   true,
      output_directory:        "build",
      output_name:             "Helpr.ipa",
      include_symbols:         true,
      xcargs:                  signing_xcargs,
      export_options:          export_options_for_signing
    )

    upload_to_testflight(
      api_key:                           api_key,
      ipa:                               "build/Helpr.ipa",
      skip_waiting_for_build_processing: false,
      changelog:                         changelog_text,
      distribute_external:               false,
      notify_external_testers:           true,   # ping internal testers on new build
      groups:                            ["Internal Testers"]
    )
  end

  # ──────────────────────────────────────────────────────────────────────
  # App Store submission
  # ──────────────────────────────────────────────────────────────────────
  desc "Bump build, archive, upload, and submit for App Store review"
  lane :release do
    api_key = asc_api_key

    configure_signing!
    increment_build_number(xcodeproj: PROJECT)

    # See note in :beta lane: omit `configuration:` and `codesigning_identity:`
    # to avoid gym injecting duplicate `-configuration` / CODE_SIGN_IDENTITY
    # flags into xcodebuild (Xcode 16 rejects the duplicate `-configuration`).
    build_app(
      **xcode_build_target,
      scheme:                  SCHEME,
      export_method:           "app-store",
      clean:                   true,
      output_directory:        "build",
      output_name:             "Helpr.ipa",
      include_symbols:         true,
      xcargs:                  signing_xcargs,
      export_options:          export_options_for_signing
    )

    upload_to_app_store(
      api_key:                           api_key,
      ipa:                               "build/Helpr.ipa",
      app_identifier:                    APP_ID,
      submit_for_review:                 true,
      automatic_release:                 true,
      force:                             true,
      precheck_include_in_app_purchases: false,
      submission_information: {
        add_id_info_uses_idfa:               false,
        export_compliance_uses_encryption:   false
      },
      release_notes: { "en-US" => changelog_text },
      skip_screenshots: true,
      skip_metadata:    false,
      metadata_path:    "fastlane/metadata"
    )
  end
end
