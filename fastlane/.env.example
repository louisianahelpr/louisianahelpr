# Copy to fastlane/.env and fill in. NEVER commit fastlane/.env (already gitignored).
#
# Get these from https://appstoreconnect.apple.com/access/api
# Create a "Team Key" with App Manager role, download the .p8 once.

ASC_KEY_ID="ABCDE12345"                              # 10-char Key ID from App Store Connect
ASC_ISSUER_ID="69a6de70-xxxx-xxxx-xxxx-xxxxxxxxxxxx" # Issuer ID (UUID, shown above the keys list)
ASC_KEY_PATH="/Users/you/AppStoreConnect_AuthKey.p8" # Absolute path to the downloaded .p8 file

# From https://developer.apple.com/account (top-right team selector)
DEVELOPER_TEAM_ID="ABCD123456"                       # 10-char alphanumeric

# Your Apple ID email (the one signed in to Xcode)
FASTLANE_APPLE_ID="you@example.com"

# Optional — only needed if your Apple ID belongs to multiple App Store Connect teams
ASC_TEAM_ID=""
