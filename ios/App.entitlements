<?xml version="1.0" encoding="UTF-8"?>
<!--
  Helpr — iOS entitlements template.

  This file mirrors ios/App/App/App.entitlements, which is wired into the
  committed Xcode project via CODE_SIGN_ENTITLEMENTS = App/App.entitlements.
  Keep both copies aligned so GitHub → Xcode/Fastlane builds populate all
  capabilities automatically.

  Bundle ID: com.Helpr     Team ID: P85MCK558V
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Push notifications. Use "production" — Apple maps this to the
      sandbox APNs server automatically for development provisioning
      profiles, and to the production server for App Store / TestFlight
      builds. There is no need to flip this between dev and prod.
    -->
    <key>aps-environment</key>
    <string>production</string>

    <!--
      Associated Domains: Universal Links + Shared Web Credentials.
      Pairs with public/.well-known/apple-app-site-association.

      `applinks:` — lets https://www.louisianahelpr.com/* deep-link into
      the app instead of opening Safari.

      `webcredentials:` — lets iOS Password AutoFill (iCloud Keychain)
      share saved credentials between Safari on www.louisianahelpr.com
      and the in-app login/signup forms. Without it iOS treats the app
      and the site as unrelated identities and refuses both "Save
      Password" and auto-suggest in the app's password fields. The
      `autoComplete` tokens on Login.tsx / Signup.tsx are necessary but
      NOT sufficient — iOS also requires this entry AND the matching
      `webcredentials` block in the AASA file (which is present).

      WWW AND APEX (since 2026-10-03; Q1130).

      The apex now SERVES the AASA itself: the Vercel domain-level 307 on
      `louisianahelpr.com` was cleared (owner-approved, 2026-10-03), and
      vercel.json's host rule still sends every OTHER apex path to www, so
      people and search engines stay on www. Verified 2026-10-03:

        curl -s -o /dev/null -w '%{http_code}' https://louisianahelpr.com/.well-known/apple-app-site-association
        -> 200 application/json
        curl -sI https://louisianahelpr.com/home
        -> HTTP/2 307, location: https://www.louisianahelpr.com/home

      (Until then the apex 307'd every path, Apple's CDN does not follow
      redirects for AASA, and the apex was deliberately not claimed.)
      Every link the app generates is still www (authRedirects'
      getPublicSiteUrl, ShareJobButton, IdentityHeader, SosShareButton,
      CompletionPrompts); the apex entries make a hand-typed or shared
      apex URL open the app too. The claim takes effect with the next iOS
      build. Guard: e2e/happy-path/zz-runtime-probe.spec.ts 3a fails if any
      claimed domain (these files) redirects its AASA.

      THIS FILE IS THE MIRROR, NOT THE ACTIVE ONE. The App target signs
      against ios/App/App/App.entitlements (CODE_SIGN_ENTITLEMENTS =
      App/App.entitlements). This copy had drifted: it still claimed the
      apex and was missing `webcredentials:` entirely — so anyone reading
      or reusing it would have reintroduced both the dead apex
      association and the AutoFill bug. Keep the two files identical.
    -->
    <key>com.apple.developer.associated-domains</key>
    <array>
        <string>applinks:www.louisianahelpr.com</string>
        <string>applinks:louisianahelpr.com</string>
        <string>webcredentials:www.louisianahelpr.com</string>
        <string>webcredentials:louisianahelpr.com</string>
    </array>

    <!--
      Sign in with Apple — required because the app exposes an
      "Log in with Apple" button. Without this entitlement Apple will
      reject the build (App Store Review Guideline 4.8).
    -->
    <key>com.apple.developer.applesignin</key>
    <array>
        <string>Default</string>
    </array>
</dict>
</plist>
