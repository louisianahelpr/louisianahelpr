require "yaml"

metadata = YAML.safe_load(
  File.read(File.expand_path("ios_app_metadata.yml", __dir__)),
  permitted_classes: [],
  aliases: false
)

app_identifier(metadata.fetch("identity").fetch("bundle_id"))
apple_id(ENV["FASTLANE_APPLE_ID"] || metadata.fetch("identity").fetch("apple_id").to_s)
itc_team_id(ENV["ASC_TEAM_ID"])
team_id(ENV["DEVELOPER_TEAM_ID"] || metadata.fetch("identity").fetch("team_id"))
