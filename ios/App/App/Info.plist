<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Louisiana Helpr</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Louisiana Helpr</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>7112</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<!--
		  iPhone is portrait-only. UI is designed around the bottom-nav
		  dock + 100dvh viewport lock; rotating to landscape breaks the
		  layout. iPad keeps the full orientation set below.
		-->
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.lifestyle</string>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>tel</string>
		<string>mailto</string>
		<string>sms</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Helpr needs camera access so you can take before and after job photos and upload verification documents.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Record voice notes to send in chat.</string>
	<!-- REQUIRED for the chat composer's dictation button. iOS gates the Web
	     Speech API behind this key separately from the microphone key above:
	     without it the OS refuses speech recognition before it ever prompts,
	     the WebView surfaces a bare `service-not-allowed`, and the mic button
	     appears to do nothing at all. App Review also rejects a binary that
	     uses speech recognition without it. Microphone permission alone is NOT
	     enough — recording audio and transcribing it are two separate grants. -->
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Helpr transcribes your voice so you can dictate chat messages instead of typing.</string>
<key>NSFaceIDUsageDescription</key>
	<string>Helpr uses Face ID to confirm it's you before cashing out your earnings.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Helpr uses your location to show nearby jobs, and to share your position with the poster while you are on your way to a job — including when your screen is off — until you mark yourself arrived. Tracking stops there.</string>
	<!--
	  Present for TWO reasons, neither of which is that the app requests Always.
	  1. App Store Connect rejected build 7101 (v1.0.4) with ITMS-90683 for its
	     absence: Apple's static analysis reads the BINARY, and
	     @capacitor/geolocation's CLLocationManager wrapper references
	     requestAlwaysAuthorization, so the key is demanded whether or not the
	     app calls it.
	  2. iOS may later offer the user an "Always Allow" upgrade prompt of its
	     own once it sees sustained background use, and it shows THIS string.
	  Helpr requests when-in-use only (IONGLOCAuthorisationRequestType is
	  hardcoded to .whenInUse in the plugin) — when-in-use plus the `location`
	  background mode is all an active en-route session needs. The copy no
	  longer claims "does not track in the background", because since
	  BackgroundLocationPlugin.swift shipped, it does — within the en-route
	  window and nowhere else. A purpose string that is out of date is an App
	  Review rejection and, worse, a lie to the person reading the prompt.
	-->
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Helpr shares your position with the poster while you are on your way to a job, including when your screen is off, and stops as soon as you mark yourself arrived. Helpr never asks for Always access and never tracks you outside an active job.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Helpr can save downloaded receipts and shared images to your photo library.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Helpr needs photo library access so you can upload job details, progress photos, and verification documents.</string>
	<key>UIRequiresFullScreen</key>
	<false/>

	<!--
	  `location` is REQUIRED for en-route tracking and is NOT sufficient on its
	  own. CoreLocation stops delivering to a suspended app unless the running
	  CLLocationManager ALSO sets allowsBackgroundLocationUpdates = true, which
	  @capacitor/geolocation never does (grep it — the symbol is absent from the
	  plugin and from IONGeolocationLib). Both halves live together:
	  ios/App/App/BackgroundLocationPlugin.swift supplies the flag, this key
	  makes setting it legal. Setting that flag WITHOUT this key raises an
	  uncatchable ObjC exception, so the plugin reads this array back at runtime
	  and degrades instead of crashing.

	  Scope: the manager is started on "I'm On My Way" and stopped on arrival.
	  Outside that window the app holds no background location claim.
	-->
	<key>UIBackgroundModes</key>
	<array>
			<string>remote-notification</string>
			<string>location</string>
		</array>
	
		<key>UIViewControllerBasedStatusBarAppearance</key>
		<false/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
		<key>CFBundleURLSchemes</key>
	<array>
		<string>com.googleusercontent.apps.830470550612-4q4rslusnsu72c62vo18udtjb638q8is</string>
	</array>
	</dict>
		<!--
		  Private scheme used to hand a Stripe return back to the app.

		  Payments open in an in-app browser sheet, and iOS deliberately refuses
		  to re-enter an app from a Universal Link opened inside that same app's
		  SFSafariViewController — so the https success_url cannot bounce us
		  home on its own. Stripe in turn only accepts http(s) for success_url,
		  so the return is a two-step: Stripe -> our tagged https page ->
		  helpr:///path -> here. See src/lib/nativeReturnBounce.ts.

		  Registering it here is also the trust boundary: this scheme is only
		  deliverable to this bundle, which is why src/lib/deepLinkRoute.ts is
		  allowed to route it without the https host allowlist.
		-->
		<dict>
		<key>CFBundleURLName</key>
		<string>com.Helpr.nativereturn</string>
		<key>CFBundleURLSchemes</key>
	<array>
		<string>helpr</string>
	</array>
		</dict>
	</array>

	<!--
	  Alternate App Icons (iOS 10.3+).
	  Primary "AppIcon" is managed by Assets.xcassets/AppIcon.appiconset
	  (the ornate Garden District ironwork H).

	  There is NO alternate icon. The "AppIcon-Fleur" source
	  (public/app-icon-alt.svg — a flat bark plate with a geometric H)
	  was deleted 2026-08-19: it was never the brand mark, never shipped,
	  and its CFBundleAlternateIcons block was never declared here.
	  scripts/generate-ios-icons.mjs still has an alternate-icon branch,
	  but it now takes its no-source path and logs
	  "(no alternate icon - skipping)", so nothing breaks.

	  If an alternate icon is ever wanted again: add the source back at
	  public/app-icon-alt.svg, run `node scripts/generate-ios-icons.mjs`
	  on a Mac, drag ios/App/App/AlternateIcons/ into the Xcode App group
	  as a folder reference (blue folder, not yellow group), and only THEN
	  declare CFBundleAlternateIcons. Apple's ASC validator rejects builds
	  whose CFBundleAlternateIcons reference files absent from the .ipa
	  (ITMS-90032) — declaring it first is the failure mode.
	-->
	<key>CFBundleIcons</key>
	<dict>
		<key>CFBundlePrimaryIcon</key>
		<dict>
			<key>CFBundleIconName</key>
			<string>AppIcon</string>
		</dict>
	</dict>
	<key>CFBundleIcons~ipad</key>
	<dict>
		<key>CFBundlePrimaryIcon</key>
		<dict>
			<key>CFBundleIconName</key>
			<string>AppIcon</string>
		</dict>
	</dict>
	<key>NSContactsUsageDescription</key>
	<string>Helpr can access contacts only if you choose to invite a friend by phone or email.</string>
</dict>
</plist>
