{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "composite": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "target": "ES2020",
    "types": [
      "vitest/globals"
    ],
    "useDefineForClassFields": true
  },
  "include": [
    "src",
    "supabase/functions/_shared/businessSeatTiers.ts",
    "supabase/functions/_shared/proTiers.ts",
    "supabase/functions/_shared/helperFees.ts",
    "supabase/functions/_shared/productPrices.ts",
    "supabase/functions/_shared/escrowTiming.ts",
    "supabase/functions/_shared/cancellationFee.ts",
    "supabase/functions/_shared/instantPayoutFee.ts",
    "supabase/functions/_shared/stripeFees.ts",
    "supabase/functions/_shared/posterFees.ts",
    "supabase/functions/_shared/salesTax.ts",
    "supabase/functions/_shared/recurringSchedule.ts"
  ],
  "exclude": [
    "src/test/edge/**/*.gen.ts"
  ]
}
