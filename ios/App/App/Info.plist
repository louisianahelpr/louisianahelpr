<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Louisiana Helpr</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Louisiana Helpr</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>4809</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<!--
		  iPhone is portrait-only. UI is designed around the bottom-nav
		  dock + 100dvh viewport lock; rotating to landscape breaks the
		  layout. iPad keeps the full orientation set below.
		-->
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.lifestyle</string>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>tel</string>
		<string>mailto</string>
		<string>sms</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Helpr needs camera access so you can take before and after job photos and upload verification documents.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Record voice notes to send in chat.</string>
<key>NSFaceIDUsageDescription</key>
	<string>Helpr uses Face ID to confirm it's you before cashing out your earnings.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Helpr uses your location to show nearby jobs and confirm helpr arrival.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Helpr can save downloaded receipts and shared images to your photo library.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Helpr needs photo library access so you can upload job details, progress photos, and verification documents.</string>
	<key>UIRequiresFullScreen</key>
	<false/>

	<key>UIBackgroundModes</key>
	<array>
			<string>remote-notification</string>
		</array>
	
		<key>UIViewControllerBasedStatusBarAppearance</key>
		<false/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
		<key>CFBundleURLSchemes</key>
	<array>
		<string>com.googleusercontent.apps.830470550612-4q4rslusnsu72c62vo18udtjb638q8is</string>
	</array>
	</dict>
	</array>

	<!--
	  Alternate App Icons (iOS 10.3+).
	  Primary "AppIcon" is managed by Assets.xcassets/AppIcon.appiconset
	  (the ornate Garden District ironwork H).

	  The alternate "AppIcon-Fleur" CFBundleAlternateIcons block is
	  intentionally REMOVED until the rasterized PNGs are wired into
	  the Xcode project as a folder reference. Apple's ASC validator
	  rejects builds whose CFBundleAlternateIcons reference files that
	  don't exist in the .ipa (ITMS-90032). Re-add after running
	  `node scripts/generate-ios-icons.mjs` on a Mac and dragging
	  `ios/App/App/AlternateIcons/` into Xcode App group as a
	  folder reference (blue folder, not yellow group).
	-->
	<key>CFBundleIcons</key>
	<dict>
		<key>CFBundlePrimaryIcon</key>
		<dict>
			<key>CFBundleIconName</key>
			<string>AppIcon</string>
		</dict>
	</dict>
	<key>CFBundleIcons~ipad</key>
	<dict>
		<key>CFBundlePrimaryIcon</key>
		<dict>
			<key>CFBundleIconName</key>
			<string>AppIcon</string>
		</dict>
	</dict>
	<key>NSContactsUsageDescription</key>
	<string>Helpr can access contacts only if you choose to invite a friend by phone or email.</string>
</dict>
</plist>
