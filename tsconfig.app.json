{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "composite": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "target": "ES2020",
    "types": [
      "vitest/globals"
    ],
    "useDefineForClassFields": true
  },
  "include": [
    "src",
    "e2e/liveSession.ts",
    "e2e/readRpc.ts",
    "e2e/browserLock.ts",
    // The ONE error-screen signature list every harness shares.
    // `src/test/errorScreenPatternsVsAppProse.test.ts` imports it to prove no
    // pattern fires on the app's own prose (the `/Something went wrong/i` line
    // matched a real notification body and took out three journey legs). This
    // project is `composite`, so a file it compiles has to be listed.
    "e2e/errorScreens.ts",
    // src/test/e2eSkipsAreJustified.test.ts imports the skip inventory, allowlist
    // and reporter (TS6307 otherwise).
    "e2e/skipSites.ts",
    "e2e/skipAllowlist.ts",
    "e2e/reporters/skipReporter.ts",
    // src/test/fundedOpenJobPlan.test.ts (Q100). Pinned by src/test/e2eImportsInAppTsconfig.test.ts.
    "e2e/prod-audit/fundedOpenJobPlan.ts",
    // src/test/slowNetworkCoversEverySteps.test.ts (Q68) imports the step list.
    "e2e/slow-network/steps.ts",
    // src/test/proofPhotoTeardownDetaches.test.ts imports the teardown helpers.
    "e2e/proofPhotoTeardown.ts",
    // src/test/giftCardJourneyLedger.test.ts (SC-005) imports the journey's ledger checks.
    "e2e/giftCardLedger.ts",
    // src/test/stateMatrixPendingApprovalUnreachable.test.ts (Q251) imports the
    // manifest enumerator to assert pending_approval cells are unreachable.
    "e2e/happy-path/state-matrix/stateMatrix.ts",
    "supabase/functions/_shared/businessSeatTiers.ts",
    "supabase/functions/_shared/forEachBounded.ts",
    "supabase/functions/_shared/reservedRecipient.ts",
    "supabase/functions/_shared/disputePayoutStamp.ts",
    "supabase/functions/_shared/marketing/secretGap.ts",
    "supabase/functions/_shared/notification-templates.ts",
    "supabase/functions/_shared/proTiers.ts",
    "supabase/functions/_shared/tierNames.ts",
    "supabase/functions/_shared/tierPerks.ts",
    "supabase/functions/_shared/helperFees.ts",
    "supabase/functions/_shared/payoutClaim.ts",
    "supabase/functions/_shared/productPrices.ts",
    "supabase/functions/_shared/escrowTiming.ts",
    "supabase/functions/_shared/jobBudgetLimits.ts",
    "supabase/functions/_shared/threeDSecure.ts",
    "supabase/functions/_shared/arrivalRule.ts",
    "supabase/functions/_shared/arrivalNudge.ts",
    // The stalled-completion rule (d738344c1). The POSTER'S CARD reads it —
    // `postedJobCard/steps/posterStepContract.ts` draws its disabled box from
    // `completionStalled`, the same predicate the sweep runs on — so the app
    // project compiles it like every other shared rule beside it. This project
    // is `composite`, which means every file it compiles has to be listed.
    "supabase/functions/_shared/stalledCompletion.ts",
    "supabase/functions/_shared/productTiers.ts",
    "supabase/functions/_shared/helperEarnings.ts",
    "supabase/functions/_shared/seatTierGrant.ts",
    "supabase/functions/_shared/cancellationFee.ts",
    "supabase/functions/_shared/confirmDeadline.ts",
    "supabase/functions/_shared/stripeIdentity.ts",
    "supabase/functions/_shared/instantPayoutFee.ts",
    "supabase/functions/_shared/stripeFees.ts",
    "supabase/functions/_shared/posterFees.ts",
    "supabase/functions/_shared/tipFees.ts",
    "supabase/functions/_shared/salesTax.ts",
    "supabase/functions/_shared/recurringSchedule.ts",
    "supabase/functions/_shared/storageKeys.ts",
    "supabase/functions/_shared/capturedEscrow.ts",
    "supabase/functions/_shared/unsettledDispute.ts",
    "supabase/functions/_shared/alertPolicy.ts",
    // Storage removal for deleted jobs; src/test/storageDeletionPaths.test.ts
    // parity-tests it against scripts/lib/jobMediaRest.mjs.
    "supabase/functions/_shared/jobMedia.ts",
    // Account-deletion bucket list + existence check (Q219);
    // src/test/purgeBucketsAreDeclared.test.ts runs it.
    "supabase/functions/_shared/purgeBuckets.ts",
    // Apple IAP. appleAppStore.ts is imported by src/test/appleIap.test.ts to
    // test the product registry and entitlement maths directly; jwt.ts comes
    // with it because appleAppStore mints the App Store Server API bearer
    // through it (dynamically, but TS still resolves the module).
    "supabase/functions/_shared/appleAppStore.ts",
    "supabase/functions/_shared/jwt.ts",
    "supabase/functions/_shared/banStatus.ts",
    "supabase/functions/ai-job-builder/sanitize.ts",
    // The design-system scales live here, and `src/lib/utils.test.ts` reads
    // them to prove every `ds-*` token was taught to tailwind-merge. Deriving
    // the inventory from the config is the whole point — a hand-typed mirror
    // in the test is what let `text-ds-10` silently eat `text-primary-foreground`
    // on <Badge>. This project is `composite`, so every compiled file is listed.
    "tailwind.config.ts"
  ],
  "exclude": [
    "src/test/edge/**/*.gen.ts",
    "src/test/marketingDuplicateScan.test.ts"
  ]
}
