require "base64"
require "fileutils"
require "json"
require "openssl"
require "securerandom"
require "shellwords"
require "tmpdir"

# Helpr — iOS App Store automation
# Local: bundle exec fastlane ios beta | release
# CI:    invoked by .github/workflows/deploy.yml

default_platform(:ios)

# Resolve paths from the repo root, not from fastlane/ (Fastlane's default cwd).
REPO_ROOT = File.expand_path("..", __dir__)
WORKSPACE = File.join(REPO_ROOT, "ios/App/App.xcworkspace")
PROJECT   = File.join(REPO_ROOT, "ios/App/App.xcodeproj")
SCHEME    = "App"
APP_ID    = "com.Helpr"

CHANGELOG_PATH = ENV["CHANGELOG_PATH"] || File.join(REPO_ROOT, "fastlane/changelog.txt")

def xcode_build_target
  if File.exist?(WORKSPACE)
    UI.message("Using Xcode workspace: #{WORKSPACE}")
    { workspace: WORKSPACE }
  elsif File.exist?(PROJECT)
    UI.message("Using Xcode project: #{PROJECT} (Swift Package Manager)")
    { project: PROJECT }
  else
    UI.user_error!("Missing #{WORKSPACE} and #{PROJECT}")
  end
end

def changelog_text
  File.exist?(CHANGELOG_PATH) ? File.read(CHANGELOG_PATH) : "Bug fixes and improvements."
end

def ci_fallback_build_number
  run_number = ENV["GITHUB_RUN_NUMBER"].to_s.strip
  run_id = ENV["GITHUB_RUN_ID"].to_s.strip
  base_number = run_number.empty? ? run_id : run_number
  return "" if base_number.empty?

  run_attempt = ENV.fetch("GITHUB_RUN_ATTEMPT", "1").to_s.strip
  "#{base_number}#{run_attempt.rjust(2, "0")}"
end

def ci_environment?
  [ENV["CI"], ENV["GITHUB_ACTIONS"], ENV["GITHUB_RUN_ID"]].any? do |value|
    normalized = value.to_s.strip.downcase
    !normalized.empty? && normalized != "false" && normalized != "0"
  end
end

def distribution_certificate_p12_base64
  ENV["IOS_DISTRIBUTION_CERTIFICATE_P12_BASE64"].to_s.strip
end

def distribution_certificate_password
  ENV["IOS_DISTRIBUTION_CERTIFICATE_PASSWORD"].to_s
end

def import_distribution_certificate_from_p12!(keychain_name:, keychain_password:)
  encoded_p12 = distribution_certificate_p12_base64
  UI.user_error!("IOS_DISTRIBUTION_CERTIFICATE_P12_BASE64 is required in CI. Export your existing Apple Distribution certificate as a .p12, base64 it, and add it as a GitHub secret.") if encoded_p12.empty?

  p12_path = File.join(Dir.tmpdir, "helpr-distribution-certificate.p12")
  File.binwrite(p12_path, Base64.decode64(encoded_p12))

  import_certificate(
    certificate_path: p12_path,
    certificate_password: distribution_certificate_password,
    keychain_name: keychain_name,
    keychain_password: keychain_password
  )

  UI.success("Imported existing Apple Distribution certificate from IOS_DISTRIBUTION_CERTIFICATE_P12_BASE64")
rescue ArgumentError => e
  UI.user_error!("IOS_DISTRIBUTION_CERTIFICATE_P12_BASE64 is not valid base64: #{e.message}")
ensure
  FileUtils.rm_f(p12_path) if defined?(p12_path) && p12_path
end

def remote_latest_build_number_for_version(api_key, version)
  # Latest build number for the SPECIFIC marketing version on TestFlight.
  latest_testflight_build_number(
    api_key: api_key,
    app_identifier: APP_ID,
    version: version,
    initial_build_number: 0
  ).to_i
rescue => e
  UI.important("Could not read latest TestFlight build for version #{version}: #{e.message}")
  nil
end

def remote_latest_build_number_any_version(api_key)
  # Latest build number across ALL versions on App Store Connect (TestFlight + App Store).
  # This is Apple's true "source of truth" — Apple rejects any new build whose
  # number is <= the highest one they've ever seen for this app, regardless of
  # which marketing version it was attached to.
  latest_testflight_build_number(
    api_key: api_key,
    app_identifier: APP_ID,
    initial_build_number: 0
  ).to_i
rescue => e
  UI.important("Could not read latest TestFlight build (any version): #{e.message}")
  nil
end

def next_build_number(api_key)
  version = get_version_number(
    xcodeproj: PROJECT,
    target: SCHEME
  )

  local_candidate = get_build_number(xcodeproj: PROJECT).to_i + 1
  remote_for_version = remote_latest_build_number_for_version(api_key, version)
  remote_any_version = remote_latest_build_number_any_version(api_key)
  # Apple's rule: next build must be strictly greater than the highest build
  # number ever seen across the whole app, not just this marketing version.
  remote_max = [remote_for_version, remote_any_version].compact.max
  remote_candidate = remote_max ? remote_max + 1 : nil
  ci_candidate = ci_environment? ? ci_fallback_build_number.to_i : nil

  if remote_candidate || ci_candidate
    candidates = [local_candidate, remote_candidate, ci_candidate].compact
    chosen = candidates.max
    UI.message("Using unique build number #{chosen} for version #{version} (local #{local_candidate}, remote-for-version #{remote_for_version || 'n/a'}, remote-any-version #{remote_any_version || 'n/a'}, ci #{ci_candidate || 'n/a'})")
    return chosen
  end

  if ci_environment?
    fallback = ci_fallback_build_number
    return fallback.to_i unless fallback.empty?

    return Time.now.utc.strftime("%Y%m%d%H%M%S").to_i
  end

  local_candidate
end

def set_next_build_number!(api_key)
  build_number = next_build_number(api_key)
  increment_build_number(
    build_number: build_number,
    xcodeproj: PROJECT
  )
  UI.success("Using build number #{build_number}")
end

def extract_key_payload(raw_value)
  normalized = raw_value.to_s.strip.sub(/\A["']/, "").sub(/["']\z/, "")
  return normalized unless normalized.start_with?("{")

  parsed = JSON.parse(normalized)
  %w[key_content key private_key p8 api_key].each do |field|
    value = parsed[field].to_s.strip
    return value unless value.empty?
  end

  normalized
rescue JSON::ParserError
  normalized
end

def valid_private_key_content?(value)
  return false if value.to_s.empty? || value.include?("\x00")
  # Apple .p8 keys are PKCS#8 ("BEGIN PRIVATE KEY"). Accept EC/RSA variants too
  # in case someone exported in a different PEM wrapper.
  has_pem_header = value =~ /-----BEGIN (EC |RSA |)PRIVATE KEY-----/
  has_pem_footer = value =~ /-----END (EC |RSA |)PRIVATE KEY-----/
  return false unless has_pem_header && has_pem_footer

  OpenSSL::PKey.read(value)
  true
rescue OpenSSL::PKey::PKeyError, ArgumentError
  false
end

def describe_candidate(candidate)
  bytes = candidate.to_s.bytesize
  preview_head = candidate.to_s.byteslice(0, 30).to_s.dup.force_encoding("UTF-8")
  preview_head = preview_head.scrub("?").gsub(/[^\x20-\x7e]/, ".")
  has_begin = candidate.to_s.include?("BEGIN") ? "yes" : "no"
  has_end = candidate.to_s.include?("END") ? "yes" : "no"
  has_dashes = candidate.to_s.include?("-----") ? "yes" : "no"
  "bytes=#{bytes} starts_with=#{preview_head.inspect} BEGIN=#{has_begin} END=#{has_end} dashes=#{has_dashes}"
end

def normalized_asc_key_content
  raw_key_content = extract_key_payload(ENV["ASC_KEY_CONTENT"] || ENV["ASC_KEY"])
  return "" if raw_key_content.empty?

  candidates = []
  candidates << ["raw", raw_key_content]
  candidates << ["unescaped-newlines", raw_key_content.gsub("\\n", "\n")] if raw_key_content.include?("\\n")
  candidates << ["crlf-stripped", raw_key_content.gsub("\r", "")] if raw_key_content.include?("\r")

  # Try base64 decode (strict first, then lenient that tolerates whitespace/newlines).
  compact_base64 = raw_key_content.gsub(/\s+/, "")
  if !compact_base64.empty? && !raw_key_content.include?("BEGIN")
    begin
      candidates << ["base64-strict", Base64.strict_decode64(compact_base64)]
    rescue ArgumentError
      nil
    end
    begin
      candidates << ["base64-lenient", Base64.decode64(compact_base64)]
    rescue ArgumentError
      nil
    end
  end

  diagnostics = []
  candidates.each do |label, candidate|
    str = candidate.to_s.dup.force_encoding("UTF-8")
    str = str.encode("UTF-8", invalid: :replace, undef: :replace, replace: "") unless str.valid_encoding?
    normalized = str.delete_prefix("\uFEFF").strip
    if valid_private_key_content?(normalized)
      UI.message("ASC_KEY_CONTENT decoded successfully via strategy: #{label}")
      return normalized
    end
    diagnostics << "  - #{label}: #{describe_candidate(normalized)}"
  end

  UI.error("ASC_KEY_CONTENT/ASC_KEY could not be parsed. Tried #{candidates.size} strategies:")
  diagnostics.each { |d| UI.error(d) }
  UI.error("Raw secret length: #{ENV['ASC_KEY_CONTENT'].to_s.bytesize} bytes")
  UI.user_error!("ASC_KEY_CONTENT/ASC_KEY is invalid. Provide raw .p8 text, PEM text with escaped newlines, a base64-encoded .p8 content string, or a JSON secret containing one of: key_content, key, private_key, p8, api_key.")
end


def xcodebuild_auth_key_path
  key_path = ENV["ASC_KEY_PATH"].to_s.strip
  return key_path if !key_path.empty? && File.exist?(key_path)

  key_id = ENV["ASC_KEY_ID"].to_s.strip
  UI.user_error!("ASC_KEY_ID is required for xcodebuild authentication") if key_id.empty?
  decoded_key = normalized_asc_key_content
  UI.user_error!("No App Store Connect API key found. Set ASC_KEY_CONTENT (base64 or raw .p8 text) or ASC_KEY_PATH.") if decoded_key.empty?

  # xcodebuild expects the standard Apple filename pattern: AuthKey_<KEY_ID>.p8
  generated_path = File.join(Dir.tmpdir, "AuthKey_#{key_id}.p8")
  File.write(generated_path, decoded_key)
  generated_path
end

def xcode_target_cli_args
  target = xcode_build_target
  if target[:workspace]
    ["-workspace", target[:workspace], "-scheme", SCHEME]
  else
    ["-project", target[:project], "-scheme", SCHEME]
  end
end

def signing_cli_args
  [
    "-allowProvisioningUpdates",
    "-allowProvisioningDeviceRegistration",
    "-authenticationKeyPath", xcodebuild_auth_key_path,
    "-authenticationKeyID", ENV.fetch("ASC_KEY_ID").to_s.strip,
    "-authenticationKeyIssuerID", ENV.fetch("ASC_ISSUER_ID").to_s.strip,
    "DEVELOPMENT_TEAM=#{ENV.fetch("DEVELOPER_TEAM_ID").to_s.strip}"
  ]
end

def shelljoin_args(args)
  args.flatten.compact.map { |value| Shellwords.escape(value.to_s) }.join(" ")
end

def export_options_plist_path
  plist_path = File.join(Dir.tmpdir, "helpr-export-options.plist")
  team_id = ENV.fetch("DEVELOPER_TEAM_ID").to_s.strip
  profile_name = ENV["HELPR_PROFILE_NAME"].to_s.strip
  signing_style = profile_name.empty? ? "automatic" : "manual"

  provisioning_block = ""
  unless profile_name.empty?
    provisioning_block = <<~XML
      <key>provisioningProfiles</key>
      <dict>
        <key>#{APP_ID}</key>
        <string>#{profile_name}</string>
      </dict>
      <key>signingCertificate</key>
      <string>Apple Distribution</string>
    XML
  end

  plist = <<~PLIST
    <?xml version="1.0" encoding="UTF-8"?>
    <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
    <plist version="1.0">
    <dict>
      <key>method</key>
      <string>app-store</string>
      <key>signingStyle</key>
      <string>#{signing_style}</string>
      <key>teamID</key>
      <string>#{team_id}</string>
      <key>stripSwiftSymbols</key>
      <true/>
      <key>uploadSymbols</key>
      <true/>
      #{provisioning_block}
    </dict>
    </plist>
  PLIST
  File.write(plist_path, plist)
  plist_path
end

def build_ipa_with_xcodebuild(output_name: "Helpr.ipa")
  archive_dir = File.join(REPO_ROOT, "build", "archives")
  export_dir = File.join(REPO_ROOT, "build", "export")
  FileUtils.mkdir_p(archive_dir)
  FileUtils.rm_rf(export_dir)
  FileUtils.mkdir_p(export_dir)

  archive_path = File.join(archive_dir, "Helpr.xcarchive")
  FileUtils.rm_rf(archive_path)

  common_args = xcode_target_cli_args + signing_cli_args

  sh("xcodebuild #{shelljoin_args(common_args + ["-resolvePackageDependencies", "-configuration", "Release"])}")

  archive_args = common_args + [
    "-configuration", "Release",
    "-destination", "generic/platform=iOS",
    "-archivePath", archive_path,
    "clean",
    "archive"
  ]
  sh("set -o pipefail && xcodebuild #{shelljoin_args(archive_args)} | xcbeautify --disable-colored-output")

  export_args = [
    "-exportArchive",
    "-archivePath", archive_path,
    "-exportPath", export_dir,
    "-exportOptionsPlist", export_options_plist_path
  ] + signing_cli_args
  sh("set -o pipefail && xcodebuild #{shelljoin_args(export_args)} | xcbeautify --disable-colored-output")

  produced_ipa = Dir[File.join(export_dir, "*.ipa")].first
  UI.user_error!("xcodebuild export did not produce an .ipa in #{export_dir}") unless produced_ipa

  final_ipa_path = File.join(REPO_ROOT, "build", output_name)
  FileUtils.mkdir_p(File.dirname(final_ipa_path))
  FileUtils.cp(produced_ipa, final_ipa_path)
  final_ipa_path
end

def asc_api_key
  # Normalize everything to raw PEM before passing it to fastlane.
  # This avoids fastlane double-decoding malformed/base64-ish input and fixes
  # the "string contains null byte" failure from App Store Connect auth.
  key_content = normalized_asc_key_content

  params = {
    key_id:    ENV["ASC_KEY_ID"],
    issuer_id: ENV["ASC_ISSUER_ID"],
    duration:  1200,
    in_house:  false
  }

  if !key_content.empty?
    params[:key_filepath] = xcodebuild_auth_key_path
  elsif ENV["ASC_KEY_PATH"] && File.exist?(ENV["ASC_KEY_PATH"])
    params[:key_filepath] = ENV["ASC_KEY_PATH"]
  else
    UI.user_error!("No App Store Connect API key found. Set ASC_KEY_CONTENT (raw .p8 or base64) or ASC_KEY_PATH.")
  end

  app_store_connect_api_key(**params)
end

platform :ios do
  before_all do
    # CI runs build/sync in workflow steps. Skip duplicate work there.
    unless ENV["CI"]
      sh("cd .. && npm run build")
      sh("cd .. && npx cap sync ios")
    end
  end

  # Inject the Apple Developer Team ID into the freshly-generated Xcode
  # project. Capacitor's `cap add ios` scaffolds App.xcodeproj with an empty
  # DEVELOPMENT_TEAM, which causes `xcodebuild archive` to fail with
  # "Signing for App requires a development team". We patch the pbxproj
  # before archiving so signing succeeds in CI without manual Xcode edits.
  # On CI we use MANUAL signing because automatic signing requires a logged-in
  # Apple ID account in Xcode's Accounts preferences — which a GitHub Actions
  # runner does not have. Instead we use `sigh` (with the App Store Connect API
  # key) to download/create the App Store distribution profile, then point the
  # Xcode project at that profile by UUID. This works headlessly on CI.
  def configure_signing!(api_key)
    team_id = ENV["DEVELOPER_TEAM_ID"]
    UI.user_error!("DEVELOPER_TEAM_ID env var is required for signing") if team_id.nil? || team_id.strip.empty?

    # 0) On CI: create an ephemeral keychain and make it the default. `cert` will
    #    import the distribution certificate into this keychain so xcodebuild
    #    can find the signing identity. Without this, sigh fetches the profile
    #    but the cert lives nowhere xcodebuild can see it, and archive fails.
    if ci_environment?
      keychain_name     = "fastlane_tmp_keychain"
      keychain_password = ENV["MATCH_KEYCHAIN_PASSWORD"].to_s.strip
      keychain_password = SecureRandom.hex(16) if keychain_password.empty?

      create_keychain(
        name:           keychain_name,
        password:       keychain_password,
        default_keychain: true,
        unlock:         true,
        timeout:        3600,
        lock_when_sleeps: false
      )
      ENV["MATCH_KEYCHAIN_NAME"]     = keychain_name
      ENV["MATCH_KEYCHAIN_PASSWORD"] = keychain_password

      # Import an existing Apple Distribution certificate from CI secrets.
      # This avoids Fastlane creating a new certificate and hitting Apple's
      # "maximum number of Distribution certificates" limit.
      import_distribution_certificate_from_p12!(
        keychain_name: keychain_name,
        keychain_password: keychain_password
      )
    end

    # 1) Fetch (or create) the App Store distribution provisioning profile
    #    via the ASC API key. This drops a .mobileprovision into build/profiles
    #    and exports SIGH_* lane context vars we use below.
    sigh(
      api_key:          api_key,
      app_identifier:   APP_ID,
      team_id:          team_id,
      adhoc:            false,
      development:      false,
      force:            true,
      readonly:         false,
      output_path:      File.join(REPO_ROOT, "build", "profiles")
    )

    profile_name = lane_context[SharedValues::SIGH_NAME] ||
                   ENV["sigh_#{APP_ID}_appstore_profile-name"]
    profile_uuid = lane_context[SharedValues::SIGH_UUID] ||
                   ENV["sigh_#{APP_ID}_appstore"]

    UI.user_error!("sigh did not return a profile name/uuid") if profile_name.nil? || profile_uuid.nil?

    # 2) Switch the Xcode project to MANUAL signing pinned to that profile.
    update_code_signing_settings(
      path:                   PROJECT,
      use_automatic_signing:  false,
      team_id:                team_id,
      bundle_identifier:      APP_ID,
      code_sign_identity:     "Apple Distribution",
      profile_name:           profile_name,
      profile_uuid:           profile_uuid,
      targets:                [SCHEME],
      build_configurations:   ["Release"]
    )

    UI.success("Configured manual signing — team=#{team_id} profile=#{profile_name}")
  end

  def signing_xcargs
    team_id = ENV["DEVELOPER_TEAM_ID"].to_s.strip
    key_id = ENV["ASC_KEY_ID"].to_s.strip
    issuer_id = ENV["ASC_ISSUER_ID"].to_s.strip
    auth_key_path = xcodebuild_auth_key_path

    # -allowProvisioningUpdates lets xcodebuild ask App Store Connect to
    # create/download provisioning assets on CI. The authenticationKey flags
    # make that work without a signed-in Xcode account on the runner.
    #
    # IMPORTANT: do NOT pass `-configuration`, `CODE_SIGN_IDENTITY=`, or
    # `CODE_SIGN_STYLE=` in xcargs. Gym auto-detects `CODE_SIGN_IDENTITY=` in
    # xcargs and treats it as `codesigning_identity`, which then makes gym
    # PREPEND its own `-configuration Release` flag to xcargs while xcodebuild
    # already gets `-configuration Release` from the scheme — Xcode 16 rejects
    # the duplicate with "option '-configuration' may only be provided once".
    # The signing identity, style, and team are already set on the Release
    # build configuration by `configure_signing!` via update_code_signing_settings,
    # so we only need to pass the App Store Connect auth flags here.
    %(-allowProvisioningUpdates -allowProvisioningDeviceRegistration -authenticationKeyPath "#{auth_key_path}" -authenticationKeyID #{key_id} -authenticationKeyIssuerID #{issuer_id} DEVELOPMENT_TEAM=#{team_id})
  end

  def export_options_for_signing
    {
      signingStyle: "automatic",
      teamID:       ENV["DEVELOPER_TEAM_ID"].to_s.strip
    }
  end

  # ──────────────────────────────────────────────────────────────────────
  # TestFlight
  # ──────────────────────────────────────────────────────────────────────
  desc "Bump build number, archive, upload to TestFlight"
  lane :beta do
    api_key = asc_api_key

    configure_signing!(api_key)
    ENV["HELPR_PROFILE_NAME"] = lane_context[SharedValues::SIGH_NAME].to_s
    set_next_build_number!(api_key)

    build_ipa_with_xcodebuild(output_name: "Helpr.ipa")

    upload_to_testflight(
      api_key:                           api_key,
      ipa:                               "build/Helpr.ipa",
      skip_waiting_for_build_processing: false,
      changelog:                         changelog_text,
      distribute_external:               false,
      notify_external_testers:           true,   # ping internal testers on new build
      groups:                            ["Internal Testers"]
    )
  end

  # ──────────────────────────────────────────────────────────────────────
  # App Store submission
  # ──────────────────────────────────────────────────────────────────────
  desc "Bump build, archive, upload, and submit for App Store review"
  lane :release do
    api_key = asc_api_key

    configure_signing!(api_key)
    ENV["HELPR_PROFILE_NAME"] = lane_context[SharedValues::SIGH_NAME].to_s
    set_next_build_number!(api_key)

    build_ipa_with_xcodebuild(output_name: "Helpr.ipa")

    upload_to_app_store(
      api_key:                           api_key,
      ipa:                               "build/Helpr.ipa",
      app_identifier:                    APP_ID,
      submit_for_review:                 true,
      automatic_release:                 true,
      force:                             true,
      precheck_include_in_app_purchases: false,
      submission_information: {
        add_id_info_uses_idfa:               false,
        export_compliance_uses_encryption:   false
      },
      release_notes: { "en-US" => changelog_text },
      skip_screenshots: true,
      skip_metadata:    false,
      metadata_path:    "fastlane/metadata"
    )
  end
end
