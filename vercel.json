{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "crons": [
    {
      "path": "/api/uptime-heartbeat",
      "schedule": "*/10 * * * *"
    }
  ],
  "functions": {
    "api/uptime-heartbeat.ts": {
      "maxDuration": 90
    },
    "api/og-profile.ts": {
      "includeFiles": "{api/_og/**,node_modules/@resvg/resvg-wasm/index_bg.wasm}"
    }
  },
  "redirects": [
    {
      "source": "/:path((?!\\.well-known/apple-app-site-association$).*)",
      "has": [
        {
          "type": "host",
          "value": "louisianahelpr.com"
        }
      ],
      "destination": "https://www.louisianahelpr.com/:path",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/support",
      "permanent": true
    },
    {
      "source": "/become-a-helpr",
      "destination": "/signup",
      "permanent": true
    },
    {
      "source": "/become-a-helper",
      "destination": "/signup",
      "permanent": true
    },
    {
      "source": "/find-work",
