{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path((?!\\.well-known/apple-app-site-association$).*)",
      "has": [
        {
          "type": "host",
          "value": "louisianahelpr.com"
        }
      ],
      "destination": "https://www.louisianahelpr.com/:path",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/auth/v1/:path*",
      "destination": "https://fncmgoasalhdgfwzhsqa.supabase.co/auth/v1/:path*"
    },
    {
      "source": "/jobs/:id",
      "destination": "/api/share?_og=job&_id=:id"
    },
    {
      "source": "/signup",
      "has": [
        {
          "type": "query",
          "key": "ref"
        }
      ],
      "destination": "/api/share?_og=signup"
    },
    {
      "source": "/user/:userId",
      "destination": "/api/share?_og=user&_id=:userId"
    },
    {
      "source": "/((?!api/|_vercel/).*)",
      "destination": "/index.html"
    }
  ],
  "images": {
    "sizes": [
      16,
      32,
      48,
      64,
      96,
      128,
      256,
      384,
      640,
      750,
      828,
      1080,
      1200,
      1920,
      2048,
      3840
    ],
    "formats": [
      "image/avif",
      "image/webp"
    ],
    "minimumCacheTTL": 31536000,
    "remotePatterns": [
      {
        "protocol": "https",
        "hostname": "fncmgoasalhdgfwzhsqa.supabase.co"
      },
      {
        "protocol": "https",
        "hostname": "api.dicebear.com"
      }
    ]
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=(self), payment=(self)"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.apple-mapkit.com https://js.stripe.com https://*.stripe.com https://us.i.posthog.com https://us-assets.i.posthog.com https://app.posthog.com https://*.sentry.io https://browser.sentry-cdn.com https://*.vercel-insights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob: data:; connect-src 'self' https://*.apple-mapkit.com https://nominatim.openstreetmap.org https://api.pwnedpasswords.com https://*.supabase.co wss://*.supabase.co https://api.stripe.com https://*.stripe.com https://*.posthog.com https://us.i.posthog.com https://us-assets.i.posthog.com https://app.posthog.com https://*.ingest.sentry.io https://*.sentry.io https://*.vercel-insights.com https://vitals.vercel-insights.com https://api.openai.com; frame-src 'self' https://js.stripe.com https://hooks.stripe.com https://checkout.stripe.com https://*.stripe.com; worker-src 'self' blob:; manifest-src 'self'; base-uri 'self'; form-action 'self' https://checkout.stripe.com; frame-ancestors 'none'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
