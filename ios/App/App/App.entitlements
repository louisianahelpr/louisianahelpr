<?xml version="1.0" encoding="UTF-8"?>
<!--
  Helpr — iOS entitlements template.

  This is the App target's active entitlements file, wired into the committed
  Xcode project via CODE_SIGN_ENTITLEMENTS = App/App.entitlements. It should
  already populate Signing & Capabilities from GitHub/Xcode/Fastlane without
  manual Xcode capability setup.

  Bundle ID: com.Helpr     Team ID: P85MCK558V
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Push notifications. Use "production" — Apple maps this to the
      sandbox APNs server automatically for development provisioning
      profiles, and to the production server for App Store / TestFlight
      builds. There is no need to flip this between dev and prod.
    -->
    <key>aps-environment</key>
    <string>production</string>

    <!--
      Associated Domains: Universal Links + Shared Web Credentials.

      `applinks:` — lets https://www.louisianahelpr.com/* deep-link into
      the app instead of opening Safari.

      `webcredentials:` — lets iOS's Password AutoFill (iCloud Keychain)
      share saved credentials between Safari (on www.louisianahelpr.com) and
      the in-app login/signup forms. Without this entry, iOS treats the
      app and the website as unrelated identities and refuses to offer
      "Save Password" or to auto-suggest the saved web credential in
      the app's password fields — which is the behavior the user
      reported: passwords don't save into iPhone Passwords from Helpr.

      The autocomplete tokens on Login.tsx / Signup.tsx (`autoComplete=
      "email"`, `"current-password"`, `"new-password"`) are necessary
      but not sufficient on their own; iOS also requires the
      `webcredentials` association below AND the matching block in
      public/.well-known/apple-app-site-association.

      WWW ONLY — the apex is deliberately NOT claimed.

      `louisianahelpr.com` 307-redirects every path (including
      /.well-known/apple-app-site-association) to `www`. Apple's CDN does
      NOT follow redirects when it fetches an AASA file, so an apex claim
      can never resolve — it is not a working association, it is a claim
      that silently fails. Verified 2026-08-31:

        curl -sI https://louisianahelpr.com/.well-known/apple-app-site-association
        -> HTTP/2 307, location: https://www.louisianahelpr.com/...

      Nothing is lost by dropping it: every link the app generates is
      already www (ShareJobButton, IdentityHeader, SosShareButton,
      CompletionPrompts, authRedirects), and so are the og:url/twitter:url
      tags. A hand-typed apex URL opens Safari rather than the app, which
      is what already happened.

      To claim the apex properly, the apex must SERVE the AASA file rather
      than redirect — that is a Vercel domain setting, not a vercel.json
      route. If that changes, re-add both apex entries here.
    -->
    <key>com.apple.developer.associated-domains</key>
    <array>
        <string>applinks:www.louisianahelpr.com</string>
        <string>webcredentials:www.louisianahelpr.com</string>
    </array>

    <!--
      Sign in with Apple — required because the app exposes an
      "Log in with Apple" button. Without this entitlement Apple will
      reject the build (App Store Review Guideline 4.8).
    -->
    <key>com.apple.developer.applesignin</key>
    <array>
        <string>Default</string>
    </array>
</dict>
</plist>
